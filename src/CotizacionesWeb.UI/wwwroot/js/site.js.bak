// ============================================
// SITE.JS - Funciones globales
// ============================================

// Función global para mostrar notificaciones
window.showNotification = function(type, message) {
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
    
    const alertHtml = `
        <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
            <i class="fas ${icon} mr-2"></i>
            ${message}
            <button type="button" class="close" data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    `;
    
    // Insertar al inicio del content
    const contentElement = $('.content, .content-wrapper .container-fluid').first();
    contentElement.prepend(alertHtml);
    
    // Auto-cerrar después de 5 segundos
    setTimeout(function() {
        $('.alert').fadeOut('slow', function() {
            $(this).remove();
        });
    }, 5000);
};

// Función para mostrar mensajes de error dentro de modales
window.showModalAlert = function(modalAlertId, message, type = 'danger') {
    const alertElement = $('#' + modalAlertId);
    const messageElement = $('#' + modalAlertId + 'Message');
    
    if (alertElement.length && messageElement.length) {
        // Actualizar clases según el tipo
        alertElement.removeClass('alert-danger alert-warning alert-info alert-success');
        alertElement.addClass('alert-' + type);
        
        // Mostrar mensaje
        messageElement.text(message);
        alertElement.removeClass('d-none');
        
        // Scroll al inicio del modal
        alertElement.closest('.modal-body').animate({ scrollTop: 0 }, 'fast');
    }
};

// Función para ocultar alertas del modal
window.hideModalAlert = function(modalAlertId) {
    const alertElement = $('#' + modalAlertId);
    if (alertElement.length) {
        alertElement.addClass('d-none');
    }
};