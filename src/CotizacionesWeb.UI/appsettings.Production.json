{
  "ConnectionStrings": {
    // Las connection strings se configuraron desde variables de entorno en Azure
    // "CotizacionesDb": "",
    // "ErpDb": ""
  },
  "Email": {
    // CONFIGURACIÓN PARA PRODUCCIÓN:
    // Estos valores serán sobrescritos por variables de entorno en Azure App Service
    "Enabled": true,
    "SmtpHost": "",        // SMTP_HOST en Azure
    "SmtpPort": 587,       // SMTP_PORT en Azure
    "SmtpUser": "",        // SMTP_USER en Azure
    "SmtpPassword": "",    // SMTP_PASSWORD en Azure (Application Setting como slot setting)
    "FromAddress": "",     // SMTP_FROM_ADDRESS en Azure
    "FromName": "Sistema de Cotizaciones - Producción",  // SMTP_FROM_NAME en Azure
    "EnableSsl": true,
    "TimeoutMs": 45000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "CotizacionesWeb.Infrastructure.Services.EmailService": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/cotizaciones-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  }
}