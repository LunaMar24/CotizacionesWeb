@model CotizacionesWeb.UI.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="content-header">
    <div class="row mb-4">
        <div class="col-sm-12">
            <h1 class="m-0">
                <i class="fas fa-tachometer-alt text-primary-custom"></i> Dashboard
            </h1>
            <p class="text-muted mt-2">Bienvenido, <strong>@Model.UsuarioNombre</strong>. Aquí tienes un resumen de las cotizaciones por estado.</p>
        </div>
    </div>
</div>

<!-- Estadísticas de Cotizaciones por Estado -->
<div class="row">
    <div class="col-lg-4 col-md-6 mb-4">
        <div class="small-box bg-secondary">
            <div class="inner">
                <h3>@Model.EstadosCotizaciones.First(e => e.CodigoEstado == 'B').Cantidad</h3>
                <p>Borrador</p>
            </div>
            <div class="icon">
                <i class="fas fa-file-alt"></i>
            </div>
            <a asp-controller="Cotizaciones" 
               asp-action="Index" 
               asp-route-FiltroBorrador="true"
               class="small-box-footer">
                Ver más <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 mb-4">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@Model.EstadosCotizaciones.First(e => e.CodigoEstado == 'P').Cantidad</h3>
                <p>Pendiente Aprobación</p>
            </div>
            <div class="icon">
                <i class="fas fa-clock"></i>
            </div>
            <a asp-controller="Cotizaciones" 
               asp-action="Index" 
               asp-route-FiltroPendienteAprobacion="true"
               class="small-box-footer">
                Ver más <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 mb-4">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@Model.EstadosCotizaciones.First(e => e.CodigoEstado == 'A').Cantidad</h3>
                <p>Aprobada</p>
            </div>
            <div class="icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <a asp-controller="Cotizaciones" 
               asp-action="Index" 
               asp-route-FiltroAprobada="true"
               class="small-box-footer">
                Ver más <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 mb-4">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@Model.EstadosCotizaciones.First(e => e.CodigoEstado == 'E').Cantidad</h3>
                <p>Enviada</p>
            </div>
            <div class="icon">
                <i class="fas fa-paper-plane"></i>
            </div>
            <a asp-controller="Cotizaciones" 
               asp-action="Index" 
               asp-route-FiltroEnviada="true"
               class="small-box-footer">
                Ver más <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 mb-4">
        <div class="small-box bg-primary">
            <div class="inner">
                <h3>@Model.EstadosCotizaciones.First(e => e.CodigoEstado == 'T').Cantidad</h3>
                <p>Aceptada</p>
            </div>
            <div class="icon">
                <i class="fas fa-thumbs-up"></i>
            </div>
            <a asp-controller="Cotizaciones" 
               asp-action="Index" 
               asp-route-FiltroAceptada="true"
               class="small-box-footer">
                Ver más <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>

    <div class="col-lg-4 col-md-6 mb-4">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@Model.EstadosCotizaciones.First(e => e.CodigoEstado == 'R').Cantidad</h3>
                <p>Rechazada</p>
            </div>
            <div class="icon">
                <i class="fas fa-times-circle"></i>
            </div>
            <a asp-controller="Cotizaciones" 
               asp-action="Index" 
               asp-route-FiltroRechazada="true"
               class="small-box-footer">
                Ver más <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/home/dashboard.css" asp-append-version="true">
    <script src="~/js/home/dashboard.js" asp-append-version="true"></script>
}

