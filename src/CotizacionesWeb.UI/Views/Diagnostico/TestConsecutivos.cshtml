@{
    ViewData["Title"] = "Diagnóstico de Consecutivos";
}

<h2>Diagnóstico de Consecutivos</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Resultados del Diagnóstico</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.Resultados != null)
                {
                    <ul class="list-group">
                        @foreach (string resultado in ViewBag.Resultados)
                        {
                            <li class="list-group-item">
                                <code>@resultado</code>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>No hay resultados disponibles.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Acciones de Prueba</h5>
            </div>
            <div class="card-body">
                <a href="@Url.Action("TestConsecutivos")" class="btn btn-primary mb-2">Probar Validación</a><br>
                <a href="@Url.Action("TestDuplicacion")" class="btn btn-warning mb-2">Probar Generación</a><br>
                <a href="@Url.Action("Parametros", "Configuracion")" class="btn btn-info">Ver Configuración</a>
            </div>
        </div>
    </div>
</div>