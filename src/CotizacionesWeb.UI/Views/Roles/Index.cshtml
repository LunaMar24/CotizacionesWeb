@model List<CotizacionesWeb.Application.Roles.RolDto>
@{
    ViewData["Title"] = "Mantenimiento de Roles";
}

<!-- Page Header -->
<div class="content-header">
    <div class="row mb-3">
        <div class="col-sm-6">
            <h1 class="m-0">
                <i class="fas fa-user-shield text-primary-custom"></i> @ViewData["Title"]
            </h1>
            <p class="text-muted mt-2">Gestiona los roles del sistema y sus permisos.</p>
        </div>
        <div class="col-sm-6 text-right">
            <a asp-action="Create" 
               class="btn btn-primary btn-custom"
               requiere-permiso="ROL_CREATE">
                <i class="fas fa-plus"></i> CREAR ROL
            </a>
        </div>
    </div>
</div>

<!-- Filtros con Card Colapsable -->
<div class="card card-filtros-custom mb-3">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-filter"></i> Filtros de BÃºsqueda
        </h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                    </div>
                    <input type="text" id="filterName" class="form-control" placeholder="Filtrar por nombre...">
                </div>
            </div>
            <div class="col-md-6">
                <select id="filterStatus" class="form-control">
                    <option value="">Todos los estados</option>
                    <option value="true">Activos</option>
                    <option value="false">Inactivos</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Roles Table -->
<div class="row">
    <div class="col-12">
        <div class="card card-custom">
            <div class="card-body p-0">
                <table class="table table-hover table-custom mb-0" id="rolesTable">
                    <thead>
                        <tr>
                            <th>Rol</th>
                            <th>Usuarios Asignados</th>
                            <th>Permisos</th>
                            <th>Estado</th>
                            <th>Fecha CreaciÃ³n</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rol in Model)
                        {
                            <tr data-nombre="@rol.Nombre.ToLower()"
                                data-activo="@rol.Activo.ToString().ToLower()">
                                <td>
                                    <div>
                                        <strong>@rol.Nombre</strong>
                                        @if (!string.IsNullOrEmpty(rol.Descripcion))
                                        {
                                            <br />
                                            <small class="text-muted">
                                                <i class="fas fa-info-circle"></i> @rol.Descripcion
                                            </small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-info">
                                        <i class="fas fa-users"></i> @rol.CantidadUsuarios
                                    </span>
                                </td>
                                <td>
                                    @if (rol.CantidadPermisos > 0)
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-lock"></i> @rol.CantidadPermisos permisos
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Sin permisos</span>
                                    }
                                </td>
                                <td>
                                    @if (rol.Activo)
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-check-circle"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">
                                            <i class="fas fa-times-circle"></i> Inactivo
                                        </span>
                                    }
                                </td>
                                <td>
                                    <small>
                                        <i class="far fa-calendar"></i>
                                        @rol.CreatedAt.ToString("dd/MM/yyyy")
                                    </small>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <button type="button"
                                                class="btn btn-sm btn-warning btn-edit-rol"
                                                data-rol-id="@rol.Id"
                                                data-rol-nombre="@rol.Nombre"
                                                requiere-permiso="ROL_EDIT"
                                                title="Modificar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-info btn-manage-permisos"
                                                data-rol-id="@rol.Id"
                                                data-rol-nombre="@rol.Nombre"
                                                requiere-permiso="ROL_PERMISOS"
                                                title="Gestionar Permisos">
                                            <i class="fas fa-lock"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-danger btn-delete-rol"
                                                data-rol-id="@rol.Id"
                                                data-rol-nombre="@rol.Nombre"
                                                data-cant-usuarios="@rol.CantidadUsuarios"
                                                requiere-permiso="ROL_DELETE"
                                                title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para editar rol -->
<div class="modal fade" id="editRolModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="editRolContent">
            <!-- Contenido cargado dinÃ¡micamente -->
        </div>
    </div>
</div>

<!-- Modal para gestionar permisos -->
<div class="modal fade" id="permisosManageModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="permisosManageContent">
            <!-- Contenido cargado dinÃ¡micamente -->
        </div>
    </div>
</div>

<!-- Modal de confirmaciÃ³n para eliminar -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle"></i> Confirmar EliminaciÃ³n
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteRolId" />
                
                <!-- Contenedor para mensajes de error dentro del modal -->
                <div id="deleteRolAlert" class="alert alert-danger d-none" role="alert">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <span id="deleteRolAlertMessage"></span>
                </div>
                
                <p>Â¿EstÃ¡ seguro que desea eliminar el rol <strong id="deleteRolNombre"></strong>?</p>
                <p class="text-danger" id="deleteWarning" style="display: none;">
                    <i class="fas fa-exclamation-circle"></i> No se puede eliminar un rol con usuarios asignados.
                </p>
            </div>
            <div class="modal-footer modal-footer-custom">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/roles/index.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/roles/create.css" asp-append-version="true">
    <script src="~/js/roles/index.js" asp-append-version="true"></script>
    @if (TempData["Success"] != null)
    {
        <script>
            $(document).ready(function() {
                if (typeof window.showNotification === 'function') {
                    window.showNotification('success', '@Html.Raw(TempData["Success"])');
                }
            });
        </script>
    }
    @if (TempData["Error"] != null)
    {
        <script>
            $(document).ready(function() {
                if (typeof window.showNotification === 'function') {
                    window.showNotification('error', '@Html.Raw(TempData["Error"])');
                }
            });
        </script>
    }
}
