@model CotizacionesWeb.UI.Models.RolCreateViewModel
@{
    ViewData["Title"] = "Crear Rol";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card card-custom">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-user-shield"></i> Crear Nuevo Rol
                </h3>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-custom"></div>
                    
                    <div class="form-group">
                        <label asp-for="Nombre" class="form-label">
                            <i class="fas fa-tag"></i> Nombre del Rol
                        </label>
                        <input asp-for="Nombre" class="form-control form-control-custom" placeholder="Ej: Supervisor" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Descripcion" class="form-label">
                            <i class="fas fa-align-left"></i> Descripción
                        </label>
                        <textarea asp-for="Descripcion" class="form-control form-control-custom" rows="3" placeholder="Descripción del rol y sus responsabilidades"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>
                    
                    <div class="form-group">
                        <div class="custom-switch-container">
                            <label class="switch">
                                <input type="checkbox" asp-for="Activo" checked>
                                <span class="slider"></span>
                            </label>
                            <label class="switch-label">
                                <i class="fas fa-toggle-on"></i> Rol Activo
                            </label>
                        </div>
                    </div>
                    
                    <div class="alert alert-info alert-custom">
                        <i class="fas fa-info-circle"></i> 
                        <strong>Nota:</strong> Después de crear el rol, podrás asignarle permisos desde el listado de roles.
                    </div>
                </div>
                
                <div class="card-footer text-right">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary btn-custom">
                        <i class="fas fa-save"></i> Guardar Rol
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="~/css/roles/create.css" asp-append-version="true">
}
