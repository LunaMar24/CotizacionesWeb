@model CotizacionesWeb.UI.Models.CotizacionIndexViewModel
@{
    ViewData["Title"] = "Listar Cotizaciones";
}

<!-- Header Principal -->
<div class="content-header-custom">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="header-title">
                <i class="fas fa-file-invoice"></i> Gestión de Cotizaciones
            </h1>
            <p class="header-subtitle">
                Administra las cotizaciones del sistema, sus versiones y estados.
            </p>
        </div>
        <div>
            <button type="button" class="btn btn-create-custom" requiere-permiso="COT_CREATE">
                <i class="fas fa-plus"></i> CREAR COTIZACIÓN
            </button>
        </div>
    </div>
</div>

<section class="content">
<div class="container-fluid">
    <!-- Filtros con Card Colapsable -->
    <div class="card card-filtros-custom mb-4">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-filter"></i> Filtros de Búsqueda
            </h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" id="filtrosForm">
                <div class="row g-3 align-items-center">
                    <!-- Búsqueda General y Versión -->
                    <div class="col-md-2">
                        <div class="mb-2">
                            <label class="form-label mb-1">Búsqueda General</label>
                            <input type="text" 
                                   class="form-control form-control-sm" 
                                   name="Filtros.Busqueda" 
                                   value="@Model.Filtros.Busqueda"
                                   placeholder="ID, cliente...">
                        </div>
                        <div>
                            <label class="form-label mb-1">Versión</label>
                            <input type="number" 
                                   step="0.1"
                                   class="form-control form-control-sm" 
                                   name="Filtros.Version" 
                                   value="@Model.Filtros.Version"
                                   placeholder="1.0">
                        </div>
                    </div>

                    <!-- Grupo: Fechas -->
                    <div class="col-md-3">
                        <div class="border rounded p-2">
                            <div class="row mb-2">
                                <label class="col-sm-4 col-form-label col-form-label-sm">Fecha Desde:</label>
                                <div class="col-sm-8">
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           name="Filtros.FechaDesde" 
                                           value="@Model.Filtros.FechaDesde?.ToString("yyyy-MM-dd")">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label col-form-label-sm">Fecha Hasta:</label>
                                <div class="col-sm-8">
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           name="Filtros.FechaHasta" 
                                           value="@Model.Filtros.FechaHasta?.ToString("yyyy-MM-dd")">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Grupo: Montos -->
                    <div class="col-md-3">
                        <div class="border rounded p-2">
                            <div class="row mb-2">
                                <label class="col-sm-4 col-form-label col-form-label-sm">Monto Desde:</label>
                                <div class="col-sm-8">
                                    <input type="number" 
                                           step="0.01"
                                           class="form-control form-control-sm" 
                                           name="Filtros.MontoDesde" 
                                           value="@Model.Filtros.MontoDesde"
                                           placeholder="0.00">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label col-form-label-sm">Monto Hasta:</label>
                                <div class="col-sm-8">
                                    <input type="number" 
                                           step="0.01"
                                           class="form-control form-control-sm" 
                                           name="Filtros.MontoHasta" 
                                           value="@Model.Filtros.MontoHasta"
                                           placeholder="0.00">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Filtro por Estado, Moneda y Botones -->
                    <div class="col-md-4">
                        <div class="row">
                            <div class="col-8">
                                <div class="mb-2">
                                    <label class="form-label mb-1">Filtrar por Estado</label>
                                    <div class="dropdown">
                                        <button class="form-control form-control-sm text-left dropdown-toggle" type="button" id="dropdownEstados" data-toggle="dropdown" aria-expanded="false">
                                            <i class="fas fa-tags"></i> Estados
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-estados" aria-labelledby="dropdownEstados">
                                            <div class="dropdown-item-custom">
                                                <input class="form-check-input" type="checkbox" id="chkBorrador" name="Filtros.FiltroBorrador" value="true" @(Model.Filtros.FiltroBorrador ? "checked" : "")>
                                                <label class="form-check-label" for="chkBorrador">
                                                    <span class="badge badge-secondary-custom">Borrador</span>
                                                </label>
                                            </div>
                                            <div class="dropdown-item-custom">
                                                <input class="form-check-input" type="checkbox" id="chkPendienteAprobacion" name="Filtros.FiltroPendienteAprobacion" value="true" @(Model.Filtros.FiltroPendienteAprobacion ? "checked" : "")>
                                                <label class="form-check-label" for="chkPendienteAprobacion">
                                                    <span class="badge badge-warning-custom">Pendiente Aprobación</span>
                                                </label>
                                            </div>
                                            <div class="dropdown-item-custom">
                                                <input class="form-check-input" type="checkbox" id="chkAprobada" name="Filtros.FiltroAprobada" value="true" @(Model.Filtros.FiltroAprobada ? "checked" : "")>
                                                <label class="form-check-label" for="chkAprobada">
                                                    <span class="badge badge-success-custom">Aprobada</span>
                                                </label>
                                            </div>
                                            <div class="dropdown-item-custom">
                                                <input class="form-check-input" type="checkbox" id="chkEnviada" name="Filtros.FiltroEnviada" value="true" @(Model.Filtros.FiltroEnviada ? "checked" : "")>
                                                <label class="form-check-label" for="chkEnviada">
                                                    <span class="badge badge-info-custom">Enviada</span>
                                                </label>
                                            </div>
                                            <div class="dropdown-item-custom">
                                                <input class="form-check-input" type="checkbox" id="chkAceptada" name="Filtros.FiltroAceptada" value="true" @(Model.Filtros.FiltroAceptada ? "checked" : "")>
                                                <label class="form-check-label" for="chkAceptada">
                                                    <span class="badge badge-primary-custom">Aceptada</span>
                                                </label>
                                            </div>
                                            <div class="dropdown-item-custom">
                                                <input class="form-check-input" type="checkbox" id="chkRechazada" name="Filtros.FiltroRechazada" value="true" @(Model.Filtros.FiltroRechazada ? "checked" : "")>
                                                <label class="form-check-label" for="chkRechazada">
                                                    <span class="badge badge-danger-custom">Rechazada</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <label class="form-label mb-1">Filtrar por Moneda</label>
                                    <select class="form-control form-control-sm" 
                                            name="Filtros.Moneda">
                                        <option value="">Todas las monedas</option>
                                        @if (ViewBag.MonedasDisponibles != null)
                                        {
                                            foreach (var moneda in (List<(string codigo, string simbolo, string nombre)>)ViewBag.MonedasDisponibles)
                                            {
                                                <option value="@moneda.codigo" selected="@(Model.Filtros.Moneda == moneda.codigo)">
                                                    @moneda.simbolo @moneda.codigo - @moneda.nombre
                                                </option>
                                            }
                                        }
                                        else
                                        {
                                            <!-- Fallback estático si no hay datos dinámicos -->
                                            <option value="CRC" selected="@(Model.Filtros.Moneda == "CRC")">¢ CRC - Colón</option>
                                            <option value="USD" selected="@(Model.Filtros.Moneda == "USD")">$ USD - Dólar</option>
                                            <option value="EUR" selected="@(Model.Filtros.Moneda == "EUR")">€ EUR - Euro</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-4">
                                <div style="padding-top: 24px;">
                                    <button type="submit" class="btn btn-primary btn-sm btn-block mb-2">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                    <a asp-action="Index" class="btn btn-secondary btn-sm btn-block">
                                        <i class="fas fa-times"></i> Limpiar
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Cotizaciones -->
        @if (Model.Cotizaciones.Any())
        {
            <div class="table-wrapper-custom">
                <table class="table table-custom-modern">
                    <thead>
                        <tr>
                            <th>ID COTIZACIÓN</th>
                            <th>CLIENTE</th>
                            <th>EMPRESA</th>
                            <th>MONEDA</th>
                            <th>ESTADO</th>
                            <th>VERSIÓN</th>
                            <th>MONTO</th>
                            <th>FECHA CREACIÓN</th>
                            <th>FECHA ENVÍO</th>
                            <th class="text-center">ESTADOS</th>
                            <th class="text-center">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cotizacion in Model.Cotizaciones)
                        {
                            <tr data-cotizacion-id="@cotizacion.CotizacionId" 
                                data-nombre="@cotizacion.NombreInteresado.ToLower()" 
                                data-empresa="@cotizacion.EmpresaInteresado.ToLower()"
                                data-estado="@cotizacion.EstadoActual">
                                <td>
                                    <strong class="text-primary">@cotizacion.CotizacionId</strong>
                                </td>
                                <td>
                                    <div class="text-dark">@cotizacion.NombreInteresado</div>
                                    @if (!string.IsNullOrEmpty(cotizacion.EmpresaInteresado))
                                    {
                                        <small class="text-muted">
                                            <i class="fas fa-building"></i> @cotizacion.EmpresaInteresado
                                        </small>
                                    }
                                </td>
                                <td>@cotizacion.EmpresaInteresado</td>
                                <td>
                                    <span class="badge badge-moneda">
                                        @FormatHelper.GetCurrencySymbol(cotizacion.Moneda) @cotizacion.Moneda
                                    </span>
                                </td>
                                <td>
                                    @switch (cotizacion.EstadoActual)
                                    {
                                        case 'B':
                                            <span class="badge badge-status badge-secondary-custom">Borrador</span>
                                            break;
                                        case 'P':
                                            <span class="badge badge-status badge-warning-custom">Pendiente Aprobación</span>
                                            break;
                                        case 'A':
                                            <span class="badge badge-status badge-success-custom">Aprobada</span>
                                            break;
                                        case 'E':
                                            <span class="badge badge-status badge-info-custom">Enviada</span>
                                            break;
                                        case 'T':
                                            <span class="badge badge-status badge-primary-custom">Aceptada</span>
                                            break;
                                        case 'R':
                                            <span class="badge badge-status badge-danger-custom">Rechazada</span>
                                            break;
                                        case 'C':
                                            <span class="badge badge-status badge-warning-custom">Cancelada</span>
                                            break;
                                        case 'X':
                                            <span class="badge badge-status badge-dark-custom">Archivada</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-version">@FormatHelper.FormatVersion(cotizacion.NumeroVersion)</span>
                                </td>
                                <td>
                                    <strong class="text-dark">@FormatHelper.FormatCurrency(cotizacion.MontoCotizacion, cotizacion.Moneda)</strong>
                                </td>
                                <td>
                                    <i class="far fa-calendar"></i> @cotizacion.FechaCreacion.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @if (cotizacion.FechaEnvio.HasValue)
                                    {
                                        <i class="far fa-clock"></i> @cotizacion.FechaEnvio.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                
                                <!-- NUEVA COLUMNA: Botones de Transición de Estados -->
                                <td class="text-center">
                                    <div class="btn-group-states">
                                        @switch (cotizacion.EstadoActual)
                                        {
                                            case 'B': // Borrador
                                                <button type="button" 
                                                        class="btn-state btn-state-warning btn-enviar-aprobacion" 
                                                        data-id="@cotizacion.CotizacionId"
                                                        title="Enviar a Aprobación"
                                                        data-confirm="true">
                                                    <i class="fas fa-paper-plane"></i>
                                                </button>
                                                <button type="button" 
                                                        class="btn-state btn-state-dark btn-archivar" 
                                                        data-id="@cotizacion.CotizacionId"
                                                        title="Archivar"
                                                        requiere-permiso="COT_ARCHIVE"
                                                        data-confirm="true">
                                                    <i class="fas fa-archive"></i>
                                                </button>
                                                break;

                                            case 'P': // PendienteAprobacion
                                                <button type="button" 
                                                        class="btn-state btn-state-success btn-aprobar" 
                                                        data-id="@cotizacion.CotizacionId"
                                                        title="Aprobar"
                                                        requiere-permiso="COT_APPROVE"
                                                        data-confirm="true">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button type="button" 
                                                        class="btn-state btn-state-warning btn-devolver-borrador" 
                                                        data-id="@cotizacion.CotizacionId"
                                                        title="Devolver a Borrador"
                                                        data-confirm="true">
                                                    <i class="fas fa-undo"></i>
                                                </button>
                                                break;
                                                
                                            case 'A': // Aprobada
                                                <button type="button" 
                                                        class="btn-state btn-state-info btn-enviar-cliente" 
                                                        data-id="@cotizacion.CotizacionId"
                                                        title="Enviar al Cliente"
                                                        requiere-permiso="COT_SEND_CLIENT"
                                                        data-confirm="true">
                                                    <i class="fas fa-envelope"></i>
                                                </button>
                                                break;
                                                
                                            case 'E': // Enviada
                                                <button type="button" 
                                                        class="btn-state btn-state-primary btn-marcar-aceptada" 
                                                        data-id="@cotizacion.CotizacionId"
                                                        title="Marcar como Aceptada"
                                                        requiere-permiso="COT_ACCEPT"
                                                        data-confirm="true">
                                                    <i class="fas fa-thumbs-up"></i>
                                                </button>
                                                <button type="button" 
                                                        class="btn-state btn-state-danger btn-marcar-rechazada" 
                                                        data-id="@cotizacion.CotizacionId"
                                                        title="Marcar como Rechazada"
                                                        requiere-permiso="COT_REJECT"
                                                        data-confirm="true">
                                                    <i class="fas fa-thumbs-down"></i>
                                                </button>
                                                break;
                                                
                                            case 'T': // Aceptada
                                                <button type="button" 
                                                        class="btn-state btn-state-dark btn-archivar" 
                                                        data-id="@cotizacion.CotizacionId"
                                                        title="Archivar"
                                                        requiere-permiso="COT_ARCHIVE"
                                                        data-confirm="true">
                                                    <i class="fas fa-archive"></i>
                                                </button>
                                                if (cotizacion.EnviadoERP != 'S')
                                                {
                                                    <button type="button" 
                                                            class="btn-state btn-state-primary btn-enviar-erp" 
                                                            data-id="@cotizacion.CotizacionId"
                                                            title="Enviar al ERP"
                                                            requiere-permiso="COT_SEND_ERP"
                                                            data-confirm="true">
                                                        <i class="fas fa-database"></i>
                                                    </button>
                                                }
                                                break;
                                                
                                            case 'R': // Rechazada
                                                <button type="button" 
                                                        class="btn-state btn-state-dark btn-archivar" 
                                                        data-id="@cotizacion.CotizacionId"
                                                        title="Archivar"
                                                        requiere-permiso="COT_ARCHIVE"
                                                        data-confirm="true">
                                                    <i class="fas fa-archive"></i>
                                                </button>
                                                break;
                                                
                                            case 'X': // Archivada
                                                <span class="text-muted">
                                                    <i class="fas fa-lock"></i> Sin acciones
                                                </span>
                                                break;
                                        }
                                    </div>
                                </td>

                                <!-- COLUMNA: Acciones Generales -->
                                <td class="text-center">
                                    <div class="btn-group-actions">
                                        <!-- Botones comunes para todos los estados -->
                                        <button type="button" 
                                                class="btn-action btn-action-edit btn-detalle" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Detalle"
                                                requiere-permiso="COT_VIEW_DETAIL">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        
                                        <!-- Editar - SOLO para estado Borrador -->
                                        @if (cotizacion.EstadoActual == 'B')
                                        {
                                            <button type="button" 
                                                    class="btn-action btn-action-warning btn-editar" 
                                                    data-id="@cotizacion.CotizacionId"
                                                    title="Editar Cotización"
                                                    requiere-permiso="COT_EDIT">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        }
                                        
                                        <button type="button" 
                                                class="btn-action btn-action-info btn-historial" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Historial"
                                                requiere-permiso="COT_VIEW_HISTORY">
                                            <i class="fas fa-history"></i>
                                        </button>
                                        <button type="button" 
                                                class="btn-action btn-action-secondary btn-versiones" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Versiones"
                                                requiere-permiso="COT_VIEW_VERSIONS">
                                            <i class="fas fa-code-branch"></i>
                                        </button>

                                        @* Copiar - Disponible para cualquier estado con versión actual *@
                                        <button type="button" 
                                                class="btn-action btn-action-copy btn-copiar" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Copiar (Nueva Versión)"
                                                requiere-permiso="COT_COPY">
                                            <i class="fas fa-copy"></i>
                                        </button>

                                        @* Duplicar - Disponible para cualquier estado *@
                                        <button type="button" 
                                                class="btn-action btn-action-delete btn-duplicar" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Duplicar (Nueva Cotización)"
                                                requiere-permiso="COT_DUPLICATE">
                                            <i class="fas fa-clone"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Footer con total -->
            <div class="table-footer-custom">
                <span class="text-muted">
                    Total de cotizaciones: <strong>@Model.Cotizaciones.Count</strong>
                </span>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-inbox fa-3x mb-3"></i>
                <p>No se encontraron cotizaciones</p>
                <small class="text-muted">Ajusta los filtros o crea una nueva cotización</small>
            </div>
        }
    </div>
</section>

<!-- Modal para Historial -->
<div class="modal fade" id="modalHistorial" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="modalHistorialContent">
            <!-- Contenido cargado dinámicamente -->
        </div>
    </div>
</div>

<!-- Modal para Versiones -->
<div class="modal fade" id="modalVersiones" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content" id="modalVersionesContent">
            <!-- Contenido cargado dinámicamente -->
        </div>
    </div>
</div>

<!-- Modal de Confirmación Genérico -->
<div class="modal fade" id="modalConfirmacion" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" id="modalConfirmacionHeader">
                <h5 class="modal-title" id="modalConfirmacionTitulo">
                    <i class="fas fa-question-circle"></i> Confirmar Acción
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalConfirmacionMensaje">
                <!-- Mensaje dinámico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmarAccion">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para solicitar comentario al copiar versión -->
@Html.Partial("_ComentarioCopiaModal")

@Html.AntiForgeryToken()

@section Scripts {
    <link rel="stylesheet" href="~/css/cotizaciones/index.css" asp-append-version="true">
    <script src="~/js/cotizaciones/index.js" asp-append-version="true"></script>
    
    <script>
        $(document).ready(function() {
            // ========================================
            // MODAL DE COMENTARIO DE COPIA - JavaScript que estaba en _ComentarioCopiaModal.cshtml
            // ========================================
            
            // Configurar modal de comentario de copia
            $('#modalComentarioCopia').on('shown.bs.modal', function() {
                $('#comentarioCopia').focus();
            });
            
            // Limpiar modal al cerrar
            $('#modalComentarioCopia').on('hidden.bs.modal', function() {
                $('#formComentarioCopia')[0].reset();
                $('#btnConfirmarCopia').prop('disabled', false).html('<i class="fas fa-copy"></i> Crear Nueva Versión');
            });
            
            // Manejar confirmación de copia
            $('#btnConfirmarCopia').on('click', function() {
                const btn = $(this);
                const comentario = $('#comentarioCopia').val().trim();
                const cotizacionId = $('#cotizacionIdCopia').val();
                const versionId = $('#versionIdCopia').val();
                const esVersionAntigua = $('#esVersionAntiguaCopia').val() === 'true';
                const tipoCopia = $('#tipoCopiaCopia').val();
                
                // Deshabilitar botón y mostrar loading
                btn.prop('disabled', true).html('<span class="loading-spinner"></span> Procesando...');
                
                // Preparar datos para envío
                const formData = {
                    cotizacionId: cotizacionId,
                    comentario: comentario,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                };
                
                // Agregar campos específicos según tipo de copia
                if (tipoCopia === 'especifica') {
                    formData.versionId = parseInt(versionId);
                    formData.esVersionAntigua = esVersionAntigua;
                }
                
                // Determinar URL según tipo de copia
                const url = tipoCopia === 'actual' 
                    ? '/Cotizaciones/CopiarVersion' 
                    : '/Cotizaciones/CopiarVersionEspecifica';
                
                // Enviar solicitud
                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            $('#modalComentarioCopia').modal('hide');
                            showNotification('success', response.message);
                            
                            // Cerrar modal de versiones si está abierta
                            $('#modalVersiones').modal('hide');
                            
                            // Recargar página después de un momento
                            setTimeout(function() {
                                location.reload();
                            }, 1500);
                        } else {
                            showNotification('error', response.message);
                            btn.prop('disabled', false).html('<i class="fas fa-copy"></i> Crear Nueva Versión');
                        }
                    },
                    error: function() {
                        showNotification('error', 'Error al crear la nueva versión');
                        btn.prop('disabled', false).html('<i class="fas fa-copy"></i> Crear Nueva Versión');
                    }
                });
            });
        });
    </script>
    
    @if (TempData["Success"] != null)
    {
        <script>
            $(document).ready(function() {
                showNotification('success', '@TempData["Success"]');
            });
        </script>
    }
    
    @if (TempData["Error"] != null)
    {
        <script>
            $(document).ready(function() {
                showNotification('error', '@TempData["Error"]');
            });
        </script>
    }
}
