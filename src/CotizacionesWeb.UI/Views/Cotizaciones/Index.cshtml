@model CotizacionesWeb.UI.Models.CotizacionIndexViewModel
@{
    ViewData["Title"] = "Listar Cotizaciones";
}

<!-- Header Principal -->
<div class="content-header-custom">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="header-title">
                <i class="fas fa-file-invoice"></i> Gestión de Cotizaciones
            </h1>
            <p class="header-subtitle">
                Administra las cotizaciones del sistema, sus versiones y estados.
            </p>
        </div>
        <div>
            <button type="button" class="btn btn-create-custom" requiere-permiso="COT_CREATE">
                <i class="fas fa-plus"></i> CREAR COTIZACIÓN
            </button>
        </div>
    </div>
</div>

<section class="content">
<div class="container-fluid">
    <!-- Filtros con Card Colapsable -->
    <div class="card card-filtros-custom mb-4">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-filter"></i> Filtros de Búsqueda
            </h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" id="filtrosForm">
                <div class="row g-3">
                    <!-- Búsqueda General -->
                    <div class="col-md-3">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text input-icon-custom">
                                    <i class="fas fa-search"></i>
                                </span>
                            </div>
                            <input type="text" 
                                   class="form-control form-control-custom" 
                                   name="Filtros.Busqueda" 
                                   value="@Model.Filtros.Busqueda"
                                   placeholder="Filtrar por ID, cliente, empresa...">
                        </div>
                    </div>

                    <!-- Fecha Desde -->
                    <div class="col-md-2">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text input-icon-custom">
                                    <i class="fas fa-calendar"></i>
                                </span>
                            </div>
                            <input type="date" 
                                   class="form-control form-control-custom" 
                                   name="Filtros.FechaDesde" 
                                   value="@Model.Filtros.FechaDesde?.ToString("yyyy-MM-dd")"
                                   placeholder="Desde">
                        </div>
                    </div>

                    <!-- Fecha Hasta -->
                    <div class="col-md-2">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text input-icon-custom">
                                    <i class="fas fa-calendar"></i>
                                </span>
                            </div>
                            <input type="date" 
                                   class="form-control form-control-custom" 
                                   name="Filtros.FechaHasta" 
                                   value="@Model.Filtros.FechaHasta?.ToString("yyyy-MM-dd")"
                                   placeholder="Hasta">
                        </div>
                    </div>

                    <!-- Filtro por Estados -->
                    <div class="col-md-3">
                        <div class="dropdown">
                            <button class="form-control form-control-custom text-left dropdown-toggle" type="button" id="dropdownEstados" data-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-tags"></i> Filtrar por estado
                            </button>
                            <div class="dropdown-menu dropdown-menu-estados" aria-labelledby="dropdownEstados">
                                <div class="dropdown-item-custom">
                                    <input class="form-check-input" type="checkbox" id="chkBorrador" name="Filtros.FiltroBorrador" value="true" @(Model.Filtros.FiltroBorrador ? "checked" : "")>
                                    <label class="form-check-label" for="chkBorrador">
                                        <span class="badge badge-secondary-custom">Borrador</span>
                                    </label>
                                </div>
                                <div class="dropdown-item-custom">
                                    <input class="form-check-input" type="checkbox" id="chkPendienteAprobacion" name="Filtros.FiltroPendienteAprobacion" value="true" @(Model.Filtros.FiltroPendienteAprobacion ? "checked" : "")>
                                    <label class="form-check-label" for="chkPendienteAprobacion">
                                        <span class="badge badge-warning-custom">Pendiente Aprobación</span>
                                    </label>
                                </div>
                                <div class="dropdown-item-custom">
                                    <input class="form-check-input" type="checkbox" id="chkAprobada" name="Filtros.FiltroAprobada" value="true" @(Model.Filtros.FiltroAprobada ? "checked" : "")>
                                    <label class="form-check-label" for="chkAprobada">
                                        <span class="badge badge-success-custom">Aprobada</span>
                                    </label>
                                </div>
                                <div class="dropdown-item-custom">
                                    <input class="form-check-input" type="checkbox" id="chkEnviada" name="Filtros.FiltroEnviada" value="true" @(Model.Filtros.FiltroEnviada ? "checked" : "")>
                                    <label class="form-check-label" for="chkEnviada">
                                        <span class="badge badge-info-custom">Enviada</span>
                                    </label>
                                </div>
                                <div class="dropdown-item-custom">
                                    <input class="form-check-input" type="checkbox" id="chkAceptada" name="Filtros.FiltroAceptada" value="true" @(Model.Filtros.FiltroAceptada ? "checked" : "")>
                                    <label class="form-check-label" for="chkAceptada">
                                        <span class="badge badge-primary-custom">Aceptada</span>
                                    </label>
                                </div>
                                <div class="dropdown-item-custom">
                                    <input class="form-check-input" type="checkbox" id="chkRechazada" name="Filtros.FiltroRechazada" value="true" @(Model.Filtros.FiltroRechazada ? "checked" : "")>
                                    <label class="form-check-label" for="chkRechazada">
                                        <span class="badge badge-danger-custom">Rechazada</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Botones -->
                    <div class="col-md-2 d-flex">
                        <button type="submit" class="btn btn-primary btn-custom mr-2">
                            <i class="fas fa-search"></i>
                        </button>
                        <a asp-action="Index" class="btn btn-secondary btn-custom">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Cotizaciones -->
        @if (Model.Cotizaciones.Any())
        {
            <div class="table-wrapper-custom">
                <table class="table table-custom-modern">
                    <thead>
                        <tr>
                            <th>ID COTIZACIÓN</th>
                            <th>CLIENTE</th>
                            <th>EMPRESA</th>
                            <th>ESTADO</th>
                            <th>VERSIÓN</th>
                            <th>MONTO</th>
                            <th>FECHA CREACIÓN</th>
                            <th>FECHA ENVÍO</th>
                            <th class="text-center">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cotizacion in Model.Cotizaciones)
                        {
                            <tr data-cotizacion-id="@cotizacion.CotizacionId" 
                                data-nombre="@cotizacion.NombreInteresado.ToLower()" 
                                data-empresa="@cotizacion.EmpresaInteresado.ToLower()"
                                data-estado="@cotizacion.EstadoActual">
                                <td>
                                    <strong class="text-primary">@cotizacion.CotizacionId</strong>
                                </td>
                                <td>
                                    <div class="text-dark">@cotizacion.NombreInteresado</div>
                                    @if (!string.IsNullOrEmpty(cotizacion.EmpresaInteresado))
                                    {
                                        <small class="text-muted">
                                            <i class="fas fa-building"></i> @cotizacion.EmpresaInteresado
                                        </small>
                                    }
                                </td>
                                <td>@cotizacion.EmpresaInteresado</td>
                                <td>
                                    @switch (cotizacion.EstadoActual)
                                    {
                                        case 'B':
                                            <span class="badge badge-status badge-secondary-custom">Borrador</span>
                                            break;
                                        case 'P':
                                            <span class="badge badge-status badge-warning-custom">Pendiente Aprobación</span>
                                            break;
                                        case 'A':
                                            <span class="badge badge-status badge-success-custom">Aprobada</span>
                                            break;
                                        case 'E':
                                            <span class="badge badge-status badge-info-custom">Enviada</span>
                                            break;
                                        case 'T':
                                            <span class="badge badge-status badge-primary-custom">Aceptada</span>
                                            break;
                                        case 'R':
                                            <span class="badge badge-status badge-danger-custom">Rechazada</span>
                                            break;
                                        case 'C':
                                            <span class="badge badge-status badge-warning-custom">Cancelada</span>
                                            break;
                                        case 'X':
                                            <span class="badge badge-status badge-dark-custom">Archivada</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-version">v@cotizacion.VersionActual</span>
                                </td>
                                <td>
                                    <strong class="text-dark">@cotizacion.MontoCotizacion.ToString("C2")</strong>
                                </td>
                                <td>
                                    <i class="far fa-calendar"></i> @cotizacion.FechaCreacion.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @if (cotizacion.FechaEnvio.HasValue)
                                    {
                                        <i class="far fa-clock"></i> @cotizacion.FechaEnvio.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group-actions">
                                        <button type="button" 
                                                class="btn-action btn-action-edit btn-detalle" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Detalle"
                                                requiere-permiso="COT_VIEW">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" 
                                                class="btn-action btn-action-info btn-historial" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Historial"
                                                requiere-permiso="COT_VIEW">
                                            <i class="fas fa-history"></i>
                                        </button>
                                        <button type="button" 
                                                class="btn-action btn-action-secondary btn-versiones" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Versiones"
                                                requiere-permiso="COT_VIEW">
                                            <i class="fas fa-code-branch"></i>
                                        </button>
                                        <button type="button" 
                                                class="btn-action btn-action-copy btn-copiar" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Copiar (Nueva Versión)"
                                                requiere-permiso="COT_EDIT">
                                            <i class="fas fa-copy"></i>
                                        </button>
                                        <button type="button" 
                                                class="btn-action btn-action-delete btn-duplicar" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Duplicar (Nueva Cotización)"
                                                requiere-permiso="COT_CREATE">
                                            <i class="fas fa-clone"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Footer con total -->
            <div class="table-footer-custom">
                <span class="text-muted">
                    Total de cotizaciones: <strong>@Model.Cotizaciones.Count</strong>
                </span>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-inbox fa-3x mb-3"></i>
                <p>No se encontraron cotizaciones</p>
                <small class="text-muted">Ajusta los filtros o crea una nueva cotización</small>
            </div>
        }
    </div>
</section>

<!-- Modal para Historial -->
<div class="modal fade" id="modalHistorial" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="modalHistorialContent">
            <!-- Contenido cargado dinámicamente -->
        </div>
    </div>
</div>

<!-- Modal para Versiones -->
<div class="modal fade" id="modalVersiones" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content" id="modalVersionesContent">
            <!-- Contenido cargado dinámicamente -->
        </div>
    </div>
</div>

<!-- Modal de Confirmación Genérico -->
<div class="modal fade" id="modalConfirmacion" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" id="modalConfirmacionHeader">
                <h5 class="modal-title" id="modalConfirmacionTitulo">
                    <i class="fas fa-question-circle"></i> Confirmar Acción
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalConfirmacionMensaje">
                <!-- Mensaje dinámico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmarAccion">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <link rel="stylesheet" href="~/css/cotizaciones/index.css" asp-append-version="true">
    <script src="~/js/cotizaciones/index.js" asp-append-version="true"></script>
    
    @if (TempData["Success"] != null)
    {
        <script>
            $(document).ready(function() {
                showNotification('success', '@TempData["Success"]');
            });
        </script>
    }
    
    @if (TempData["Error"] != null)
    {
        <script>
            $(document).ready(function() {
                showNotification('error', '@TempData["Error"]');
            });
        </script>
    }
}
