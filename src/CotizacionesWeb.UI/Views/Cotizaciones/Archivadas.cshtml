@model CotizacionesWeb.UI.Models.CotizacionIndexViewModel
@{
    ViewData["Title"] = "Cotizaciones Archivadas";
}

<!-- Header Principal -->
<div class="content-header-custom">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="header-title">
                <i class="fas fa-archive"></i> Cotizaciones Archivadas
            </h1>
            <p class="header-subtitle">
                Consulta cotizaciones archivadas del sistema. Solo lectura.
            </p>
        </div>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> VOLVER A GESTIÓN
            </a>
        </div>
    </div>
</div>

<section class="content">
<div class="container-fluid">
    <!-- Filtros con Card Colapsable -->
    <div class="card card-filtros-custom mb-4">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-filter"></i> Filtros de Búsqueda
            </h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Archivadas" method="get" id="filtrosForm">
                <div class="row g-3 align-items-center">
                    <!-- Búsqueda General y Versión -->
                    <div class="col-md-3">
                        <div class="mb-2">
                            <label class="form-label mb-1">Búsqueda General</label>
                            <input type="text" 
                                   class="form-control form-control-sm" 
                                   name="Filtros.Busqueda" 
                                   value="@Model.Filtros.Busqueda"
                                   placeholder="ID, cliente...">
                        </div>
                        <div>
                            <label class="form-label mb-1">Versión</label>
                            <input type="number" 
                                   step="0.1"
                                   class="form-control form-control-sm" 
                                   name="Filtros.Version" 
                                   value="@Model.Filtros.Version"
                                   placeholder="1.0">
                        </div>
                    </div>

                    <!-- Grupo: Fechas -->
                    <div class="col-md-3">
                        <div class="border rounded p-2">
                            <div class="row mb-2">
                                <label class="col-sm-4 col-form-label col-form-label-sm">Fecha Desde:</label>
                                <div class="col-sm-8">
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           name="Filtros.FechaDesde" 
                                           value="@Model.Filtros.FechaDesde?.ToString("yyyy-MM-dd")">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label col-form-label-sm">Fecha Hasta:</label>
                                <div class="col-sm-8">
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           name="Filtros.FechaHasta" 
                                           value="@Model.Filtros.FechaHasta?.ToString("yyyy-MM-dd")">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Grupo: Montos -->
                    <div class="col-md-3">
                        <div class="border rounded p-2">
                            <div class="row mb-2">
                                <label class="col-sm-4 col-form-label col-form-label-sm">Monto Desde:</label>
                                <div class="col-sm-8">
                                    <input type="number" 
                                           step="0.01"
                                           class="form-control form-control-sm" 
                                           name="Filtros.MontoDesde" 
                                           value="@Model.Filtros.MontoDesde"
                                           placeholder="0.00">
                                </div>
                            </div>
                            <div class="row">
                                <label class="col-sm-4 col-form-label col-form-label-sm">Monto Hasta:</label>
                                <div class="col-sm-8">
                                    <input type="number" 
                                           step="0.01"
                                           class="form-control form-control-sm" 
                                           name="Filtros.MontoHasta" 
                                           value="@Model.Filtros.MontoHasta"
                                           placeholder="0.00">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Filtro por Moneda y Botones (sin estado porque todas están archivadas) -->
                    <div class="col-md-3">
                        <div class="mb-2">
                            <label class="form-label mb-1">Filtrar por Moneda</label>
                            <select class="form-control form-control-sm" 
                                    name="Filtros.Moneda">
                                <option value="">Todas las monedas</option>
                                @if (ViewBag.MonedasDisponibles != null)
                                {
                                    foreach (var moneda in (List<(string codigo, string simbolo, string nombre)>)ViewBag.MonedasDisponibles)
                                    {
                                        <option value="@moneda.codigo" selected="@(Model.Filtros.Moneda == moneda.codigo)">
                                            @moneda.simbolo @moneda.codigo - @moneda.nombre
                                        </option>
                                    }
                                }
                                else
                                {
                                    <!-- Fallback estático si no hay datos dinámicos -->
                                    <option value="CRC" selected="@(Model.Filtros.Moneda == "CRC")">? CRC - Colón</option>
                                    <option value="USD" selected="@(Model.Filtros.Moneda == "USD")">$ USD - Dólar</option>
                                    <option value="EUR" selected="@(Model.Filtros.Moneda == "EUR")">€ EUR - Euro</option>
                                }
                            </select>
                        </div>
                        <div style="padding-top: 24px;">
                            <button type="submit" class="btn btn-primary btn-sm btn-block mb-2">
                                <i class="fas fa-search"></i> Buscar
                            </button>
                            <a asp-action="Archivadas" class="btn btn-secondary btn-sm btn-block">
                                <i class="fas fa-times"></i> Limpiar
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Cotizaciones Archivadas -->
        @if (Model.Cotizaciones.Any())
        {
            <div class="table-wrapper-custom">
                <table class="table table-custom-modern">
                    <thead>
                        <tr>
                            <th>ID COTIZACIÓN</th>
                            <th>CLIENTE</th>
                            <th>EMPRESA</th>
                            <th>MONEDA</th>
                            <th>ESTADO</th>
                            <th>VERSIÓN</th>
                            <th>MONTO</th>
                            <th>FECHA CREACIÓN</th>
                            <th>FECHA MODIFICACIÓN</th>
                            <th class="text-center">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cotizacion in Model.Cotizaciones)
                        {
                            <tr data-cotizacion-id="@cotizacion.CotizacionId" 
                                data-nombre="@cotizacion.NombreInteresado.ToLower()" 
                                data-empresa="@cotizacion.EmpresaInteresado.ToLower()"
                                data-estado="@cotizacion.EstadoActual">
                                <td>
                                    <strong class="text-primary">@cotizacion.CotizacionId</strong>
                                </td>
                                <td>
                                    <div class="text-dark">@cotizacion.NombreInteresado</div>
                                    @if (!string.IsNullOrEmpty(cotizacion.EmpresaInteresado))
                                    {
                                        <small class="text-muted">
                                            <i class="fas fa-building"></i> @cotizacion.EmpresaInteresado
                                        </small>
                                    }
                                </td>
                                <td>@cotizacion.EmpresaInteresado</td>
                                <td>
                                    <span class="badge badge-moneda">
                                        @FormatHelper.GetCurrencySymbol(cotizacion.Moneda) @cotizacion.Moneda
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-status badge-dark-custom">Archivada</span>
                                </td>
                                <td>
                                    <span class="badge badge-version">@FormatHelper.FormatVersion(cotizacion.NumeroVersion)</span>
                                </td>
                                <td>
                                    <strong class="text-dark">@FormatHelper.FormatCurrency(cotizacion.MontoCotizacion, cotizacion.Moneda)</strong>
                                </td>
                                <td>
                                    <i class="far fa-calendar"></i> @cotizacion.FechaCreacion.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @if (cotizacion.FechaUltimaActualizacion.HasValue)
                                    {
                                        <i class="far fa-clock"></i> @cotizacion.FechaUltimaActualizacion.Value.ToString("dd/MM/yyyy")
                                        <small class="text-muted d-block">Archivada</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <!-- COLUMNA: Acciones para Archivadas -->
                                <td class="text-center">
                                    <div class="btn-group-actions">
                                        <!-- Ver Detalle -->
                                        <button type="button" 
                                                class="btn-action btn-action-edit btn-detalle" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Detalle"
                                                requiere-permiso="COT_ARCHIVE_VIEW_DETAIL">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        
                                        <!-- Ver Historial -->
                                        <button type="button" 
                                                class="btn-action btn-action-info btn-historial" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Historial"
                                                requiere-permiso="COT_ARCHIVE_VIEW_DETAIL">
                                            <i class="fas fa-history"></i>
                                        </button>

                                        <!-- Ver Versiones -->
                                        <button type="button" 
                                                class="btn-action btn-action-secondary btn-versiones" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Versiones"
                                                requiere-permiso="COT_ARCHIVE_VIEW_DETAIL">
                                            <i class="fas fa-code-branch"></i>
                                        </button>

                                        <!-- Reactivar (si tiene permisos) -->
                                        <button type="button" 
                                                class="btn-action btn-action-success btn-reactivar" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Reactivar Cotización"
                                                requiere-permiso="COT_ARCHIVE_REACTIVATE"
                                                style="display: none;">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Footer con total -->
            <div class="table-footer-custom">
                <span class="text-muted">
                    Total de cotizaciones archivadas: <strong>@Model.Cotizaciones.Count</strong>
                </span>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-archive fa-3x mb-3"></i>
                <p>No se encontraron cotizaciones archivadas</p>
                <small class="text-muted">Ajusta los filtros o verifica que existan cotizaciones archivadas</small>
            </div>
        }
    </div>
</section>

<!-- Modal para Historial -->
<div class="modal fade" id="modalHistorial" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="modalHistorialContent">
            <!-- Contenido cargado dinámicamente -->
        </div>
    </div>
</div>

<!-- Modal para Versiones -->
<div class="modal fade" id="modalVersiones" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content" id="modalVersionesContent">
            <!-- Contenido cargado dinámicamente -->
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <link rel="stylesheet" href="~/css/cotizaciones/index.css" asp-append-version="true">
    <script src="~/js/cotizaciones/index.js" asp-append-version="true"></script>
    
    <script>
        $(document).ready(function() {
            // Funcionalidad básica para archivadas (solo consulta)
            
            // Ver Historial
            $('.btn-historial').on('click', function () {
                const cotizacionId = $(this).attr('data-id');
                
                $('#modalHistorialContent').html('<div class="text-center p-5"><div class="spinner-border text-primary"></div></div>');
                $('#modalHistorial').modal('show');
                
                $.get('/Cotizaciones/Historial/' + cotizacionId, function (data) {
                    $('#modalHistorialContent').html(data);
                }).fail(function () {
                    $('#modalHistorialContent').html('<div class="p-4 text-center text-danger"><i class="fas fa-exclamation-triangle fa-2x mb-2"></i><p>Error al cargar el historial</p></div>');
                });
            });

            // Ver Versiones
            $('.btn-versiones').on('click', function () {
                const cotizacionId = $(this).attr('data-id');
                
                $('#modalVersionesContent').html('<div class="text-center p-5"><div class="spinner-border text-primary"></div></div>');
                $('#modalVersiones').modal('show');
                
                $.get('/Cotizaciones/Versiones/' + cotizacionId, function (data) {
                    $('#modalVersionesContent').html(data);
                }).fail(function () {
                    $('#modalVersionesContent').html('<div class="p-4 text-center text-danger"><i class="fas fa-exclamation-triangle fa-2x mb-2"></i><p>Error al cargar las versiones</p></div>');
                });
            });

            // Ver Detalle
            $('.btn-detalle').on('click', function () {
                const cotizacionId = $(this).attr('data-id');
                
                // Navegar directamente a la vista de detalle
                window.location.href = '/Cotizaciones/Detalle/' + cotizacionId;
            });

            // TODO: Implementar funcionalidad de reactivación cuando se requiera
            $('.btn-reactivar').on('click', function () {
                const cotizacionId = $(this).attr('data-id');
                alert('Funcionalidad de reactivación pendiente de implementar: ' + cotizacionId);
            });
        });
    </script>
    
    @if (TempData["Success"] != null)
    {
        <script>
            $(document).ready(function() {
                showNotification('success', '@TempData["Success"]');
            });
        </script>
    }
    
    @if (TempData["Error"] != null)
    {
        <script>
            $(document).ready(function() {
                showNotification('error', '@TempData["Error"]');
            });
        </script>
    }
}