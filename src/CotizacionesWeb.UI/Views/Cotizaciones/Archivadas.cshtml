@model CotizacionesWeb.UI.Models.CotizacionIndexViewModel
@{
    ViewData["Title"] = "Cotizaciones Archivadas";
}

<!-- Header Principal -->
<div class="content-header-custom">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="header-title">
                <i class="fas fa-archive"></i> Cotizaciones Archivadas
            </h1>
            <p class="header-subtitle">
                Consulta cotizaciones archivadas del sistema. Solo lectura.
            </p>
        </div>
    </div>
</div>

<section class="content">
<div class="container-fluid">
    <!-- Filtros con Card Colapsable -->
    <div class="card card-filtros-custom mb-4">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-filter"></i> Filtros de Búsqueda
            </h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Archivadas" method="get" id="filtrosForm">
                <div class="row g-3">
                    <!-- SECCIÓN: Búsqueda Principal -->
                    <div class="col-12">
                        <div class="filter-section">
                            <h6 class="filter-section-title">
                                <i class="fas fa-search text-primary"></i> Búsqueda Principal
                            </h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">Búsqueda General</label>
                                    <input type="text" 
                                           class="form-control" 
                                           name="Filtros.Busqueda" 
                                           value="@Model.Filtros.Busqueda"
                                           placeholder="ID de cotización, nombre de cliente o empresa...">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Versión</label>
                                    <input type="number" 
                                           step="0.1"
                                           class="form-control" 
                                           name="Filtros.Version" 
                                           value="@Model.Filtros.Version"
                                           placeholder="Ej: 1.0, 2.1">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Moneda</label>
                                    <select class="form-control" name="Filtros.Moneda">
                                        <option value="">Todas las monedas</option>
                                        @if (ViewBag.MonedasDisponibles != null)
                                        {
                                            foreach (var moneda in (List<(string codigo, string simbolo, string nombre)>)ViewBag.MonedasDisponibles)
                                            {
                                                <option value="@moneda.codigo" selected="@(Model.Filtros.Moneda == moneda.codigo)">
                                                    @moneda.simbolo @moneda.codigo - @moneda.nombre
                                                </option>
                                            }
                                        }
                                        else
                                        {
                                            <!-- Fallback estático si no hay datos dinámicos -->
                                            <option value="CRC" selected="@(Model.Filtros.Moneda == "CRC")">? CRC - Colón</option>
                                            <option value="USD" selected="@(Model.Filtros.Moneda == "USD")">$ USD - Dólar</option>
                                            <option value="EUR" selected="@(Model.Filtros.Moneda == "EUR")">€ EUR - Euro</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECCIÓN: Fechas -->
                    <div class="col-md-6">
                        <div class="filter-section">
                            <h6 class="filter-section-title">
                                <i class="fas fa-calendar-alt text-info"></i> Fechas
                            </h6>
                            <div class="row">
                                <div class="col-12">
                                    <label class="form-label text-muted">Fecha de Cotización</label>
                                </div>
                                <div class="col-6">
                                    <label class="form-label-sm">Desde:</label>
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           name="Filtros.FechaDesde" 
                                           value="@Model.Filtros.FechaDesde?.ToString("yyyy-MM-dd")">
                                </div>
                                <div class="col-6">
                                    <label class="form-label-sm">Hasta:</label>
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           name="Filtros.FechaHasta" 
                                           value="@Model.Filtros.FechaHasta?.ToString("yyyy-MM-dd")">
                                </div>
                                <div class="col-12 mt-2">
                                    <label class="form-label text-muted">Fecha de Archivado</label>
                                </div>
                                <div class="col-6">
                                    <label class="form-label-sm">Desde:</label>
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           name="Filtros.FechaArchivadoDesde" 
                                           value="@Model.Filtros.FechaArchivadoDesde?.ToString("yyyy-MM-dd")">
                                </div>
                                <div class="col-6">
                                    <label class="form-label-sm">Hasta:</label>
                                    <input type="date" 
                                           class="form-control form-control-sm" 
                                           name="Filtros.FechaArchivadoHasta" 
                                           value="@Model.Filtros.FechaArchivadoHasta?.ToString("yyyy-MM-dd")">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECCIÓN: Filtros Adicionales -->
                    <div class="col-md-6">
                        <div class="filter-section">
                            <h6 class="filter-section-title">
                                <i class="fas fa-filter text-warning"></i> Filtros Adicionales
                            </h6>
                            <div class="row">
                                <div class="col-12">
                                    <label class="form-label text-muted">Rango de Montos</label>
                                </div>
                                <div class="col-6">
                                    <label class="form-label-sm">Monto Desde:</label>
                                    <input type="number" 
                                           step="0.01"
                                           class="form-control form-control-sm" 
                                           name="Filtros.MontoDesde" 
                                           value="@Model.Filtros.MontoDesde"
                                           placeholder="0.00">
                                </div>
                                <div class="col-6">
                                    <label class="form-label-sm">Monto Hasta:</label>
                                    <input type="number" 
                                           step="0.01"
                                           class="form-control form-control-sm" 
                                           name="Filtros.MontoHasta" 
                                           value="@Model.Filtros.MontoHasta"
                                           placeholder="0.00">
                                </div>
                                <div class="col-12 mt-2">
                                    <label class="form-label">Usuario que Archivó</label>
                                    <input type="text" 
                                           class="form-control form-control-sm" 
                                           name="Filtros.UsuarioArchivo" 
                                           value="@Model.Filtros.UsuarioArchivo"
                                           placeholder="Nombre del usuario...">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- SECCIÓN: Filtro Especial -->
                    <div class="col-12">
                        <div class="filter-section filter-section-special">
                            <h6 class="filter-section-title">
                                <i class="fas fa-list-ul text-success"></i> Búsqueda en Detalle de Productos
                            </h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">Código de Producto</label>
                                    <input type="text" 
                                           class="form-control" 
                                           name="Filtros.BusquedaProducto" 
                                           value="@Model.Filtros.BusquedaProducto"
                                           placeholder="Buscar por código de producto en los detalles...">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Descripción de Producto</label>
                                    <input type="text" 
                                           class="form-control" 
                                           name="Filtros.BusquedaDescripcion"
                                           value="@Model.Filtros.BusquedaDescripcion"
                                           placeholder="Buscar por descripción de producto en los detalles...">
                                    <small class="text-muted">
                                        <i class="fas fa-search"></i> 
                                        Busca dentro de las descripciones de producto almacenadas en las cotizaciones archivadas.
                                    </small>
                                </div>
                            </div>
                            <small class="text-muted">
                                <i class="fas fa-info-circle"></i> 
                                Busca dentro de los códigos de producto y descripciones almacenadas en las líneas de detalle de las cotizaciones archivadas
                            </small>
                        </div>
                    </div>

                    <!-- SECCIÓN: Botones de Acción -->
                    <div class="col-12">
                        <div class="filter-actions">
                            <div class="d-flex justify-content-end gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Buscar
                                </button>
                                <a asp-action="Archivadas" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Limpiar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Cotizaciones Archivadas -->
        @if (Model.Cotizaciones.Any())
        {
            <div class="table-wrapper-custom">
                <table class="table table-custom-modern">
                    <thead>
                        <tr>
                            <th>ID COTIZACIÓN</th>
                            <th>CLIENTE</th>
                            <th>EMPRESA</th>
                            <th>MONEDA</th>
                            <th>USUARIO QUE ARCHIVÓ</th>
                            <th>TIPO ARCHIVO</th>
                            <th>VERSIÓN</th>
                            <th>MONTO</th>
                            <th>FECHA CREACIÓN</th>
                            <th>FECHA ARCHIVADO</th>
                            <th class="text-center">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cotizacion in Model.Cotizaciones)
                        {
                            <tr data-cotizacion-id="@cotizacion.CotizacionId" 
                                data-nombre="@cotizacion.NombreInteresado.ToLower()" 
                                data-empresa="@cotizacion.EmpresaInteresado.ToLower()"
                                data-estado="@cotizacion.EstadoActual"
                                data-tipo-archivo="@cotizacion.TipoArchivo">
                                <td>
                                    <strong class="text-primary">@cotizacion.CotizacionId</strong>
                                </td>
                                <td>
                                    <div class="text-dark">@cotizacion.NombreInteresado</div>
                                    @if (!string.IsNullOrEmpty(cotizacion.EmpresaInteresado))
                                    {
                                        <small class="text-muted">
                                            <i class="fas fa-building"></i> @cotizacion.EmpresaInteresado
                                        </small>
                                    }
                                </td>
                                <td>@cotizacion.EmpresaInteresado</td>
                                <td>
                                    <span class="badge badge-moneda">
                                        @FormatHelper.GetCurrencySymbol(cotizacion.Moneda) @cotizacion.Moneda
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(cotizacion.UsuarioQueArchivo))
                                    {
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-user text-warning mr-1"></i>
                                            <span class="text-dark">@cotizacion.UsuarioQueArchivo</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="fas fa-question-circle"></i> No disponible
                                        </span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var tipoArchivo = cotizacion.TipoArchivo;
                                        var badgeClass = "";
                                        var iconClass = "";
                                        var tipoTexto = "";
                                        
                                        switch (tipoArchivo)
                                        {
                                            case 'M':
                                                badgeClass = "badge-secondary";
                                                iconClass = "fas fa-user";
                                                tipoTexto = "Manual";
                                                break;
                                            case 'R':
                                                badgeClass = "badge-warning";
                                                iconClass = "fas fa-times-circle";
                                                tipoTexto = "Rechazada";
                                                break;
                                            case 'T':
                                                badgeClass = "badge-success";
                                                iconClass = "fas fa-check-circle";
                                                tipoTexto = "Concretada";
                                                break;
                                            default:
                                                badgeClass = "badge-light";
                                                iconClass = "fas fa-question-circle";
                                                tipoTexto = "Desconocido";
                                                break;
                                        }
                                    }
                                    <span class="badge @badgeClass">
                                        <i class="@iconClass"></i> @tipoTexto
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-version">@FormatHelper.FormatVersion(cotizacion.NumeroVersion)</span>
                                </td>
                                <td>
                                    <strong class="text-dark">@FormatHelper.FormatCurrency(cotizacion.MontoCotizacion, cotizacion.Moneda)</strong>
                                </td>
                                <td>
                                    <i class="far fa-calendar"></i> @cotizacion.FechaCreacion.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @if (cotizacion.FechaArchivado.HasValue)
                                    {
                                        <i class="far fa-archive"></i> @cotizacion.FechaArchivado.Value.ToString("dd/MM/yyyy")
                                        <small class="text-muted d-block">@cotizacion.FechaArchivado.Value.ToString("HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="fas fa-question-circle"></i> No disponible
                                        </span>
                                    }
                                </td>

                                <!-- COLUMNA: Acciones para Archivadas -->
                                <td class="text-center">
                                    <div class="btn-group-actions">
                                        <!-- Ver Detalle -->
                                        <button type="button" 
                                                class="btn-action-archivadas btn-detalle" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Detalle"
                                                requiere-permiso="COT_ARCHIVE_VIEW_DETAIL"
                                                tipo-restriccion="ocultar">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        
                                        <!-- Ver Historial -->
                                        <button type="button" 
                                                class="btn-action-archivadas btn-historial" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Historial"
                                                requiere-permiso="COT_VIEW_HISTORY"
                                                tipo-restriccion="ocultar">
                                            <i class="fas fa-history"></i>
                                        </button>

                                        <!-- Ver Versiones -->
                                        <button type="button" 
                                                class="btn-action-archivadas btn-versiones" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Ver Versiones"
                                                requiere-permiso="COT_VIEW_VERSIONS"
                                                tipo-restriccion="ocultar">
                                            <i class="fas fa-code-branch"></i>
                                        </button>

                                        <!-- Copiar Versión (solo para TipoArchivo 'M' y 'R') -->
                                        @if (cotizacion.TipoArchivo == 'M' || cotizacion.TipoArchivo == 'R')
                                        {
                                            <button type="button" 
                                                    class="btn-action-archivadas btn-copiar" 
                                                    data-id="@cotizacion.CotizacionId"
                                                    title="Copiar Versión"
                                                    requiere-permiso="COT_COPY_VERSION"
                                                    tipo-restriccion="ocultar">
                                                <i class="fas fa-copy"></i>
                                            </button>
                                        }

                                        <!-- Reactivar (solo para TipoArchivo 'M' y 'R') -->
                                        @if (cotizacion.TipoArchivo == 'M' || cotizacion.TipoArchivo == 'R')
                                        {
                                            <button type="button" 
                                                    class="btn-reactivar" 
                                                    data-id="@cotizacion.CotizacionId"
                                                    title="Reactivar Cotización"
                                                    requiere-permiso="COT_ARCHIVE_REACTIVATE"
                                                    tipo-restriccion="ocultar">
                                                <i class="fas fa-undo"></i>
                                            </button>
                                        }

                                        <!-- Duplicar (siempre disponible) -->
                                        <button type="button" 
                                                class="btn-action-archivadas btn-duplicar" 
                                                data-id="@cotizacion.CotizacionId"
                                                title="Duplicar Cotización"
                                                requiere-permiso="COT_DUPLICATE"
                                                tipo-restriccion="ocultar">
                                            <i class="fas fa-clone"></i>
                                        </button>
                                        
                                        <!-- Indicador visual para cotizaciones concretadas -->
                                        @if (cotizacion.TipoArchivo == 'T')
                                        {
                                            <span class="badge badge-success ml-2" title="Cotización concretada en ERP - Solo lectura y duplicación disponible">
                                                <i class="fas fa-check-circle"></i> ERP
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <!-- Footer con total -->
            <div class="table-footer-custom">
                <span class="text-muted">
                    Total de cotizaciones archivadas: <strong>@Model.Cotizaciones.Count</strong>
                </span>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-archive fa-3x mb-3"></i>
                <p>No se encontraron cotizaciones archivadas</p>
                <small class="text-muted">Ajusta los filtros o verifica que existan cotizaciones archivadas</small>
            </div>
        }
    </div>
</section>

<!-- Modal para Historial -->
<div class="modal fade" id="modalHistorial" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="modalHistorialContent">
            <!-- Contenido cargado dinámicamente -->
        </div>
    </div>
</div>

<!-- Modal para Versiones -->
<div class="modal fade" id="modalVersiones" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content" id="modalVersionesContent">
            <!-- Contenido cargado dinámicamente -->
        </div>
    </div>
</div>

<!-- Modal de Confirmación Genérico -->
<div class="modal fade" id="modalConfirmacion" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" id="modalConfirmacionHeader">
                <h5 class="modal-title" id="modalConfirmacionTitulo">
                    <i class="fas fa-question-circle"></i> Confirmar Acción
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalConfirmacionMensaje">
                <!-- Mensaje dinámico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmarAccion">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Reactivación -->
<div class="modal fade" id="modalReactivacion" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-undo text-success"></i> Reactivar Cotización
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- ✅ Área para alertas dinámicas dentro del modal -->
                <div id="modalReactivacionAlert" class="alert d-none" role="alert">
                    <button type="button" class="close" onclick="hideModalAlert('modalReactivacionAlert')">
                        <span>&times;</span>
                    </button>
                    <div id="modalReactivacionAlertContent"></div>
                </div>
                
                <!-- ✅ ÁREA DE INFORMACIÓN ESTÁTICA - SIEMPRE VISIBLE -->
                <div class="alert alert-info mb-3 static-info-area" style="border-radius: 8px;">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>¿Reactivar Cotización archivada?</strong>
                </div>
                
                <p class="mb-3" id="mensajeReactivacion">
                    Se creará una <strong>nueva cotización independiente</strong> con todos los datos de esta cotización archivada. 
                    La cotización original <strong>permanecerá archivada</strong>.
                </p>
                
                <div class="alert alert-warning mb-3" style="border-radius: 8px;">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Detalles del proceso:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Se generará un <strong>código nuevo</strong> (ej: COT-0001 → COT-0002)</li>
                        <li>El número de versión se <strong>incrementará</strong> (ej: 3.0 → 4.0)</li>
                        <li>Se copiará toda la información: interesado, productos, moneda, etc.</li>
                        <li>La nueva cotización estará en estado <strong>Borrador</strong></li>
                        <li>Podrá editarla normalmente</li>
                    </ul>
                </div>
                
                <div class="form-group">
                    <label for="motivoReactivacion" class="form-label">
                        <strong>Motivo de reactivación (obligatorio):</strong>
                    </label>
                    <textarea id="motivoReactivacion" 
                              class="form-control" 
                              rows="4" 
                              placeholder="Explique el motivo por el cual necesita reactivar esta cotización..."
                              maxlength="500"
                              required></textarea>
                    <div class="form-text">
                        <span id="contadorMotivoReactivacion">0</span>/500 caracteres
                    </div>
                </div>
                <input type="hidden" id="cotizacionIdReactivacion" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn btn-success" id="btnConfirmarReactivacion">
                    <i class="fas fa-undo"></i> Reactivar Cotización
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <link rel="stylesheet" href="~/css/cotizaciones/archivadas.css" asp-append-version="true">
    <script src="~/js/cotizaciones/archivadas.js" asp-append-version="true"></script>
    
    <script>
        // 🆕 CONTROL DE REACTIVACIÓN: Verificar si cotizaciones ya fueron reactivadas
        $(document).ready(function() {
            verificarEstadosReactivacion();
        });
        
        /**
         * Verificar qué cotizaciones ya fueron reactivadas y deshabilitar el botón correspondiente
         */
        function verificarEstadosReactivacion() {
            console.log('🔍 Verificando estados de reactivación...');
            
            const $botonesReactivar = $('.btn-reactivar');
            
            if ($botonesReactivar.length === 0) {
                console.log('ℹ️ No hay botones de reactivar en la página');
                return;
            }
            
            // Verificar cada botón de reactivar
            $botonesReactivar.each(function() {
                const $btn = $(this);
                const cotizacionId = $btn.data('id');
                
                if (cotizacionId) {
                    verificarSiYaFueReactivada(cotizacionId, $btn);
                }
            });
        }
        
        /**
         * Verificar si una cotización específica ya fue reactivada
         */
        function verificarSiYaFueReactivada(cotizacionId, $btn) {
            // Hacer consulta AJAX para verificar estado
            $.ajax({
                url: '/Cotizaciones/VerificarEstadoReactivacion',
                type: 'GET',
                data: { cotizacionId: cotizacionId },
                dataType: 'json'
            })
            .done(function(response) {
                if (response && response.success) {
                    if (response.yaFueReactivada) {
                        // Ya fue reactivada - deshabilitar botón
                        deshabilitarBotonReactivar($btn, response.fechaReactivacion, response.usuarioQueReactivo);
                    }
                    // Si no fue reactivada, el botón permanece habilitado
                } else {
                    console.warn(`⚠️ Error al verificar estado de reactivación para ${cotizacionId}: ${response?.message || 'Error desconocido'}`);
                    // En caso de error, mantener el botón habilitado
                }
            })
            .fail(function(xhr, status, error) {
                console.error(`❌ Error en AJAX al verificar reactivación de ${cotizacionId}:`, error);
                // En caso de error de conexión, mantener el botón habilitado
            });
        }
        
        /**
         * Deshabilitar un botón de reactivar y mostrar información de que ya fue reactivada
         */
        function deshabilitarBotonReactivar($btn, fechaReactivacion, usuarioQueReactivo) {
            // Cambiar apariencia del botón
            $btn.removeClass('btn-reactivar')
                .addClass('btn-action-disabled')
                .prop('disabled', true)
                .css({
                    'opacity': '0.5',
                    'cursor': 'not-allowed',
                    'background-color': '#6c757d',
                    'border-color': '#6c757d'
                });
            
            // Cambiar icono
            $btn.find('i').removeClass('fa-undo').addClass('fa-check-circle');
            
            // Actualizar tooltip
            const tooltipTexto = fechaReactivacion && usuarioQueReactivo 
                ? `Ya fue reactivada el ${fechaReactivacion} por ${usuarioQueReactivo}`
                : 'Esta cotización ya fue reactivada anteriormente';
            
            $btn.attr('title', tooltipTexto)
                .tooltip('dispose') // Remover tooltip anterior
                .tooltip(); // Crear nuevo tooltip
            
            // Remover eventos de click
            $btn.off('click');
            
            console.log(`✅ Botón de reactivar deshabilitado para cotización`);
        }
    </script>
    
    @if (TempData["Success"] != null)
    {
        <script>
            $(document).ready(function() {
                showNotification('success', '@TempData["Success"]');
            });
        </script>
    }
    
    @if (TempData["Error"] != null)
    {
        <script>
            $(document).ready(function() {
                showNotification('error', '@TempData["Error"]');
            });
        </script>
    }
}