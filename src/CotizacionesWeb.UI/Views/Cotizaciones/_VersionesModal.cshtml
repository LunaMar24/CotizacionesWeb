@model List<CotizacionesWeb.UI.Models.CotizacionVersionViewModel>

<div class="modal-header modal-header-custom">
    <h5 class="modal-title">
        <i class="fas fa-code-branch"></i> Versiones Anteriores - Cotización @ViewBag.CotizacionId
    </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-custom-modern">
                <thead>
                    <tr>
                        <th>VERSIÓN</th>
                        <th>INTERESADO</th>
                        <th>FECHA</th>
                        <th>MONEDA</th>
                        <th class="text-right">TOTAL</th>
                        <th class="text-center">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var version in Model)
                    {
                        <tr>
                            <td>
                                @{
                                    var versionText = version.NumeroVersion > 0 
                                        ? $"v{version.NumeroVersion:0.0}" 
                                        : "v0.0";
                                }
                                <span class="badge badge-version">@versionText</span>
                            </td>
                            <td>
                                <div>
                                    <strong>@version.NombreInteresado</strong>
                                </div>
                                @if (!string.IsNullOrEmpty(version.EmpresaInteresado))
                                {
                                    <small class="text-muted">
                                        <i class="fas fa-building"></i> @version.EmpresaInteresado
                                    </small>
                                }
                            </td>
                            <td>
                                <i class="far fa-calendar"></i> @version.FechaVersion.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                <span class="badge badge-info">@version.Moneda</span>
                            </td>
                            <td class="text-right">
                                <strong class="text-dark">@version.Total.ToString("C2")</strong>
                            </td>
                            <td class="text-center">
                                <div class="btn-group-actions">
                                    <button type="button" 
                                            class="btn-action btn-action-edit btn-detalle-version" 
                                            data-version-id="@version.VersionId"
                                            data-cotizacion-id="@version.CotizacionId"
                                            title="Ver Detalle"
                                            requiere-permiso="COT_VIEW_DETAIL">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button type="button" 
                                            class="btn-action btn-action-info btn-historial-version" 
                                            data-version-id="@version.VersionId"
                                            data-cotizacion-id="@version.CotizacionId"
                                            data-numero-version="@version.NumeroVersion"
                                            title="Ver Historial de esta Versión"
                                            requiere-permiso="COT_VIEW">
                                        <i class="fas fa-history"></i>
                                    </button>
                                    <button type="button" 
                                            class="btn-action btn-action-copy btn-copiar-version" 
                                            data-cotizacion-id="@version.CotizacionId"
                                            data-version-id="@version.VersionId"
                                            data-es-actual="false"
                                            data-numero-version="@version.NumeroVersion"
                                            title="Copiar Versión"
                                            requiere-permiso="COT_COPY">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                    <button type="button" 
                                            class="btn-action btn-action-delete btn-duplicar-version" 
                                            data-cotizacion-id="@version.CotizacionId"
                                            data-version-id="@version.VersionId"
                                            title="Duplicar (Nueva Cotización)"
                                            requiere-permiso="COT_DUPLICATE">
                                        <i class="fas fa-clone"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox fa-3x mb-3"></i>
            <p>No se encontraron versiones para esta cotización</p>
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">
        <i class="fas fa-times"></i> Cerrar
    </button>
</div>
