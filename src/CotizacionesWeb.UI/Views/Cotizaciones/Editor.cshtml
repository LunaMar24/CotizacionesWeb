@model CotizacionesWeb.UI.Models.CotizacionEditarViewModel
@{
  ViewData["Title"] = Model.EsNuevaCotizacion ? "Crear Cotización" : $"Editar Cotización {Model.CotizacionId}";
}

<!-- Header Principal -->
<div class="content-header-custom">
  <div class="d-flex justify-content-between align-items-start">
    <div>
      <h1 class="header-title">
        @if (Model.EsNuevaCotizacion)
        {
          <i class="fas fa-plus"></i>
          @Html.Raw("Crear Cotización")
        }
        else
        {
          <i class="fas fa-edit"></i>
          @Html.Raw("Editar Cotización ") @Model.CotizacionId
        }
        <span class="badge badge-secondary-custom ml-2">@Model.EstadoActualTexto</span>
      </h1>
      <p class="header-subtitle">
        @if (Model.EsNuevaCotizacion)
        {
          @Html.Raw("Crea una nueva cotización con información del interesado y líneas de productos.")
          <br><small class="text-muted"><i class="fas fa-info-circle"></i> Debe asignar un interesado y agregar al menos una línea de producto.</small>
        }
        else
        {
          @Html.Raw("Modifica la información de la cotización, sus líneas de productos y configuraciones.")
          <br><small class="text-muted"><i class="fas fa-info-circle"></i> Solo las cotizaciones en estado <strong>Borrador</strong> pueden ser editadas.</small>
        }
      </p>
    </div>
    <div class="d-flex gap-2">
      <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Volver al Listado
      </a>
      @if (Model.EstadoActual == 'B')
      {
        <button type="button" class="btn btn-success" id="btnGuardar">
          @if (Model.EsNuevaCotizacion)
          {
            <i class="fas fa-save"></i> @Html.Raw("Guardar")
          }
          else
          {
            <i class="fas fa-save"></i> @Html.Raw("Guardar Cambios")
          }
        </button>
      }
      else
      {
        <button type="button" class="btn btn-secondary" disabled title="Solo se puede guardar en estado Borrador">
          <i class="fas fa-lock"></i> No Editable
        </button>
      }
    </div>
  </div>
</div>

<section class="content">
  <div class="container-fluid">

    <!-- Alerta para cotizaciones no editables -->
    @if (Model.EstadoActual != 'B')
    {
      <div class="alert alert-warning mb-4">
        <i class="fas fa-exclamation-triangle"></i>
        <strong>Atención:</strong> Esta cotización está en estado <strong>@Model.EstadoActualTexto</strong> y no puede ser editada.
        Solo las cotizaciones en estado <strong>Borrador</strong> permiten edición.
      </div>
    }

    <form id="formEditarCotizacion">
      @Html.AntiForgeryToken()
      <input type="hidden" name="CotizacionId" value="@Model.CotizacionId" />
      <input type="hidden" name="VersionId" value="@Model.VersionId" />

      <div class="row">
        <!-- Columna Principal -->
        <div class="col-lg-8">
          <!-- Card: Información General (Solo Lectura) -->
          <div class="card card-primary card-outline mb-4">
            <div class="card-header" data-card-widget="collapse" style="cursor: pointer;">
              <h3 class="card-title">
                <i class="fas fa-info-circle"></i> Información General
              </h3>
              <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                  <i class="fas fa-minus"></i>
                </button>
              </div>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">ID Cotización:</strong>
                      @if (Model.EsNuevaCotizacion)
                      {
                        <span class="text-info font-weight-bold">&lt;Nueva&gt;</span>
                      }
                      else
                      {
                        <span class="text-primary font-weight-bold">@Model.CotizacionId</span>
                      }
                    </div>
                  </div>
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Estado Actual:</strong>
                      <span>
                        @switch (Model.EstadoActual)
                        {
                          case 'B':
                            <span class="badge badge-secondary-custom">@Model.EstadoActualTexto</span>
                            break;
                          case 'P':
                            <span class="badge badge-warning-custom">@Model.EstadoActualTexto</span>
                            break;
                          case 'A':
                            <span class="badge badge-success-custom">@Model.EstadoActualTexto</span>
                            break;
                          case 'E':
                            <span class="badge badge-info-custom">@Model.EstadoActualTexto</span>
                            break;
                          case 'T':
                            <span class="badge badge-primary-custom">@Model.EstadoActualTexto</span>
                            break;
                          case 'R':
                            <span class="badge badge-danger-custom">@Model.EstadoActualTexto</span>
                            break;
                          case 'X':
                            <span class="badge badge-dark-custom">@Model.EstadoActualTexto</span>
                            break;
                          default:
                            <span class="badge badge-light">@Model.EstadoActualTexto</span>
                            break;
                        }
                      </span>
                    </div>
                  </div>
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Versión:</strong>
                      <span>
                        @if (Model.EstadoActual == 'B')
                        {
                          <!-- Modo vista (etiqueta con botón de edición) -->
                          <span id="versionModoVista">
                            <span class="badge badge-version" id="versionValor">@FormatHelper.FormatVersion(Model.NumeroVersion)</span>
                            <button type="button" class="btn btn-sm btn-link p-0 ml-1" id="btnEditarVersion" title="Editar versión">
                              <i class="fas fa-pencil-alt" style="font-size: 0.7rem; color: #6c757d;"></i>
                            </button>
                          </span>

                          <!-- Modo edición (campo de entrada) -->
                          <span class="d-none" id="versionModoEdicion">
                            <input type="number" step="0.1" min="1.0" max="99.9" class="form-control form-control-sm d-inline-block"
                                   id="NumeroVersion" name="NumeroVersion"
                                   value="@Model.NumeroVersion.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                   title="Número de versión de la cotización"
                                   style="width: 80px; text-align: center; font-size: 0.875rem;">
                            <button type="button" class="btn btn-sm btn-success ml-1" id="btnGuardarVersion" title="Guardar" style="padding: 0.1rem 0.3rem;">
                              <i class="fas fa-check" style="font-size: 0.7rem;"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-secondary ml-1" id="btnCancelarVersion" title="Cancelar" style="padding: 0.1rem 0.3rem;">
                              <i class="fas fa-times" style="font-size: 0.7rem;"></i>
                            </button>
                          </span>
                        }
                        else
                        {
                          <span class="badge badge-version">@FormatHelper.FormatVersion(Model.NumeroVersion)</span>
                        }
                      </span>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Fecha Creación:</strong>
                      <span>@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                  </div>
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Fecha Versión:</strong>
                      <span>@Model.FechaVersion.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                  </div>
                  @if (Model.FechaUltimaActualizacion.HasValue)
                  {
                    <div class="info-item">
                      <div class="d-flex">
                        <strong class="info-label">Última Actualización:</strong>
                        <span>@Model.FechaUltimaActualizacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                      </div>
                    </div>
                  }
                </div>
              </div>
            </div>
          </div>

          <!-- Card: Información del Interesado -->
          <div class="card card-info card-outline mb-4">
            <div class="card-header" data-card-widget="collapse" style="cursor: pointer;">
              <h3 class="card-title">
                <i class="fas fa-user"></i> Información del Interesado
              </h3>
              <div class="card-tools">
                @if (Model.EstadoActual == 'B')
                {
                  <button type="button" class="btn btn-info btn-sm mr-2" id="btnBuscarHubSpot"
                          title="Buscar interesado en HubSpot">
                    <i class="fas fa-search"></i> Buscar en HubSpot
                  </button>
                }
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                  <i class="fas fa-minus"></i>
                </button>
              </div>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Nombre:</strong>
                      <span id="NombreInteresado">@(string.IsNullOrWhiteSpace(Model.NombreInteresado) ? "No asignado" : Model.NombreInteresado)</span>
                    </div>
                  </div>
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Email:</strong>
                      <span id="EmailInteresado">
                        @if (!string.IsNullOrWhiteSpace(Model.EmailInteresado) && Model.EmailInteresado != "N/A")
                        {
                          <span class="text-info">
                            <i class="fas fa-envelope"></i> @Model.EmailInteresado
                          </span>
                        }
                        else
                        {
                          <span class="text-muted">No asignado</span>
                        }
                      </span>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Empresa:</strong>
                      <span id="EmpresaInteresado">
                        @if (!string.IsNullOrWhiteSpace(Model.EmpresaInteresado))
                        {
                          <span><i class="fas fa-building text-info"></i> @Model.EmpresaInteresado</span>
                        }
                        else
                        {
                          <span class="text-muted">No asignado</span>
                        }
                      </span>
                    </div>
                  </div>
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Tipo:</strong>
                      <span id="TipoInteresadoDisplay">
                        @switch (Model.TipoInteresado)
                        {
                          case 'P':
                            <span class="badge badge-info"><i class="fas fa-user"></i> Persona</span>
                            break;
                          case 'E':
                            <span class="badge badge-primary"><i class="fas fa-building"></i> Empresa</span>
                            break;
                          default:
                            <span class="badge badge-secondary"><i class="fas fa-question"></i> No definido</span>
                            break;
                        }
                      </span>
                      <input type="hidden" id="TipoInteresado" name="TipoInteresado" value="@Model.TipoInteresado" />
                    </div>
                  </div>
                </div>
              </div>

              @if (Model.EstadoActual == 'B' && string.IsNullOrWhiteSpace(Model.NombreInteresado))
              {
                <div class="alert alert-warning mt-3 mb-0">
                  <i class="fas fa-thumb-tack"></i>
                  <strong>Importante:</strong> Use el botón <strong>"Buscar en HubSpot"</strong> para asignar un interesado desde HubSpot.
                </div>
              }
            </div>
          </div>

          <!-- Card: Líneas de Detalle (EDITABLE) -->
          <div class="card card-success card-outline">
            <div class="card-header">
              <h3 class="card-title">
                <i class="fas fa-list-ul"></i> Líneas de Detalle
              </h3>
              <div class="card-tools">
                @if (Model.EstadoActual == 'B')
                {
                  <button type="button" class="btn btn-success btn-sm" id="btnAgregarLinea">
                    <i class="fas fa-plus"></i> Agregar Línea
                  </button>
                }
                <span class="badge badge-success ml-2" id="contadorLineas">@Model.Detalles.Count item(s)</span>
              </div>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                <table class="table table-sm table-striped mb-0" id="tablaDetalles">
                  <thead class="thead-light sticky-top">
                    <tr>
                      <th style="background-color: #f8f9fa; width: 120px;">Producto</th>
                      <th style="background-color: #f8f9fa;">Descripción</th>
                      <th class="text-right" style="background-color: #f8f9fa; width: 100px;">Cantidad</th>
                      <th class="text-right" style="background-color: #f8f9fa; width: 120px;">Precio Unit.</th>
                      <th class="text-right" style="background-color: #f8f9fa; width: 120px;">Descuento</th>
                      <th class="text-right" style="background-color: #f8f9fa; width: 90px;">% Impuesto</th>
                      <th class="text-right" style="background-color: #f8f9fa; width: 120px;">Total</th>
                      <th class="text-center" style="background-color: #f8f9fa; width: 80px;">Acciones</th>
                    </tr>
                  </thead>
                  <tbody>
                    @for (int i = 0; i < Model.Detalles.Count; i++)
                    {
                      <tr data-detalle-id="@Model.Detalles[i].DetalleVersionId" 
                          data-index="@i" 
                          class="linea-persistente"
                          data-valores-originales='@System.Text.Json.JsonSerializer.Serialize(new { 
                            productoId = Model.Detalles[i].ProductoId, 
                            descripcion = Model.Detalles[i].Descripcion,
                            cantidad = Model.Detalles[i].Cantidad,
                            precio = Model.Detalles[i].PrecioUnitario,
                            descuento = Model.Detalles[i].Descuento
                          })'>
                        <td>
                          <div class="d-flex align-items-center">
                            <strong class="text-primary">@Model.Detalles[i].ProductoId</strong>
                          </div>
                          <input type="hidden" name="Detalles[@i].DetalleVersionId" value="@Model.Detalles[i].DetalleVersionId" />
                          <input type="hidden" name="Detalles[@i].ProductoId" value="@Model.Detalles[i].ProductoId" />
                        </td>
                        <td>
                          <span class="producto-descripcion">@Model.Detalles[i].Descripcion</span>
                          <input type="hidden" name="Detalles[@i].Descripcion" value="@Model.Detalles[i].Descripcion" />
                        </td>
                        <td class="text-right">
                          <span class="cantidad-display">@FormatHelper.FormatNumber(Model.Detalles[i].Cantidad, 2)</span>
                          <input type="hidden" name="Detalles[@i].Cantidad" value="@Model.Detalles[i].Cantidad" />
                        </td>
                        <td class="text-right">
                          <span class="precio-display">@FormatHelper.FormatCurrency(Model.Detalles[i].PrecioUnitario, Model.Moneda)</span>
                          <input type="hidden" name="Detalles[@i].PrecioUnitario" value="@Model.Detalles[i].PrecioUnitario" />
                        </td>
                        <td class="text-right">
                          @if (Model.Detalles[i].Descuento > 0)
                          {
                            <span class="text-danger descuento-display">-@FormatHelper.FormatCurrency(Model.Detalles[i].Descuento, Model.Moneda)</span>
                          }
                          else
                          {
                            <span class="text-muted descuento-display">-</span>
                          }
                          <input type="hidden" name="Detalles[@i].Descuento" value="@Model.Detalles[i].Descuento" />
                        </td>
                        <td class="text-right">
                          @if (Model.Detalles[i].PorcentajeImpuesto > 0)
                          {
                            <span class="badge badge-info">@Model.Detalles[i].PorcentajeImpuesto.ToString("N2")%</span>
                          }
                          else
                          {
                            <span class="badge badge-secondary">0%</span>
                          }
                        </td>
                        <td class="text-right">
                          <strong class="total-linea-display">@FormatHelper.FormatCurrency(Model.Detalles[i].TotalLinea, Model.Moneda)</strong>
                          <input type="hidden" name="Detalles[@i].PorcentajeImpuesto" value="@Model.Detalles[i].PorcentajeImpuesto" />
                          <input type="hidden" name="Detalles[@i].TotalLinea" value="@Model.Detalles[i].TotalLinea" />
                        </td>
                        <td class="text-center">
                          @if (Model.EstadoActual == 'B')
                          {
                            <div class="btn-actions-group">
                              <button type="button" class="btn btn-warning btn-xs btn-editar-detalle"
                                      data-index="@i" title="Editar">
                                <i class="fas fa-edit"></i>
                              </button>
                              <button type="button" class="btn btn-danger btn-xs btn-eliminar-detalle"
                                      data-index="@i" title="Eliminar">
                                <i class="fas fa-trash"></i>
                              </button>
                            </div>
                          }
                          else
                          {
                            <span class="text-muted">
                              <i class="fas fa-lock"></i>
                            </span>
                          }
                        </td>
                      </tr>
                    }
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar Derecha -->
        <div class="col-lg-4">
          <!-- Card: Resumen Financiero -->
          <div class="card card-warning card-outline mb-4">
            <div class="card-header">
              <h3 class="card-title">
                <i class="fas fa-calculator"></i> Resumen Financiero
              </h3>
            </div>
            <div class="card-body">
              <!-- Sección de Moneda Dinámica (controlada por JavaScript) -->
              <div class="moneda-section">
                <!-- El contenido se generará dinámicamente por JavaScript -->
              </div>

              <div class="financial-summary">
                <div class="d-flex justify-content-between mb-2">
                  <span>Subtotal:</span>
                  <strong id="displaySubTotal">@FormatHelper.FormatCurrency(Model.SubTotal, Model.Moneda)</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                  <span>Descuento:</span>
                  <strong class="text-danger" id="displayDescuento">@FormatHelper.FormatCurrency(Model.Descuento, Model.Moneda)</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                  <span>Subtotal Descontado:</span>
                  <strong class="text-primary" id="displaySubtotalDescontado">@FormatHelper.FormatCurrency(Model.SubTotal - Model.Descuento, Model.Moneda)</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                  <span>Impuesto:</span>
                  <strong class="text-info" id="displayImpuesto">@FormatHelper.FormatCurrency(Model.Impuesto, Model.Moneda)</strong>
                </div>
                <hr class="my-3">
                <div class="d-flex justify-content-between mb-3">
                  <span class="h5">Total:</span>
                  <strong class="h5 text-success" id="displayTotal">@FormatHelper.FormatCurrency(Model.Total, Model.Moneda)</strong>
                </div>
                <hr class="my-3">
                <div class="text-center text-muted">
                  <small>
                    <strong>Moneda:</strong> <span id="displayMonedaCodigo">@Model.Moneda</span>
                  </small>
                </div>

                <!-- Campo Tipo de Cambio - Debajo de la moneda con el mismo estilo -->
                @if (Model.EstadoActual == 'B')
                {
                  <div class="text-center text-muted mt-1">
                    <!-- Modo vista (etiqueta) -->
                    <div id="tipoCambioModoVista">
                      <small>
                        <strong>Tipo de Cambio:</strong>
                        <span id="tipoCambioValor">@(Model.TipoCambio?.ToString("N2") ?? "No definido")</span>
                        <button type="button" class="btn btn-sm btn-link p-0 ml-1" id="btnEditarTipoCambio" title="Editar tipo de cambio">
                          <i class="fas fa-pencil-alt" style="font-size: 0.7rem; color: #6c757d;"></i>
                        </button>
                      </small>
                    </div>

                    <!-- Modo edición (campo de entrada) -->
                    <div class="d-none" id="tipoCambioModoEdicion">
                      <small>
                        <strong>Tipo de Cambio:</strong>
                      </small>
                      <div class="d-flex justify-content-center align-items-center mt-1">
                        <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                               id="TipoCambio" name="TipoCambio"
                               value="@(Model.TipoCambio?.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               placeholder="520.50"
                               title="Tipo de cambio para esta cotización"
                               style="width: 100px; text-align: center; font-size: 0.875rem;">
                        <button type="button" class="btn btn-sm btn-success ml-1" id="btnGuardarTipoCambio" title="Guardar" style="padding: 0.1rem 0.3rem;">
                          <i class="fas fa-check" style="font-size: 0.7rem;"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary ml-1" id="btnCancelarTipoCambio" title="Cancelar" style="padding: 0.1rem 0.3rem;">
                          <i class="fas fa-times" style="font-size: 0.7rem;"></i>
                        </button>
                      </div>
                      <div class="mt-1">
                        <small class="text-muted" style="font-size: 0.75rem;">Opcional - Ingrese el tipo de cambio si aplica</small>
                      </div>
                    </div>
                  </div>
                }
                else if (Model.TipoCambio.HasValue && Model.TipoCambio > 0)
                {
                  <div class="text-center text-muted mt-1">
                    <small>
                      <strong>Tipo de Cambio:</strong> @Model.TipoCambio.Value.ToString("N2")
                    </small>
                  </div>
                }
              </div>
            </div>
          </div>

          <!-- Card: Fechas Importantes (Solo Lectura) - No mostrar en creación -->
          @if (!Model.EsNuevaCotizacion)
          {
            <div class="card card-info card-outline mb-4">
              <div class="card-header">
                <h3 class="card-title">
                  <i class="fas fa-calendar-alt"></i> Fechas Importantes
                </h3>
              </div>
              <div class="card-body">
                @if (Model.FechaEnvio.HasValue)
                {
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Fecha Envío:</strong>
                      <span>@Model.FechaEnvio.Value.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                  </div>
                }
                @if (Model.FechaAceptacion.HasValue)
                {
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Fecha Aceptación:</strong>
                      <span class="text-success">@Model.FechaAceptacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                  </div>
                }
                @if (Model.FechaRechazo.HasValue)
                {
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Fecha Rechazo:</strong>
                      <span class="text-danger">@Model.FechaRechazo.Value.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                  </div>
                }
                @if (Model.EnviadoERP == 'S' && Model.FechaEnvioERP.HasValue)
                {
                  <div class="info-item">
                    <div class="d-flex">
                      <strong class="info-label">Enviado al ERP:</strong>
                      <span class="text-primary">@Model.FechaEnvioERP.Value.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                  </div>
                }
                @if (!Model.FechaEnvio.HasValue && !Model.FechaAceptacion.HasValue && !Model.FechaRechazo.HasValue && Model.EnviadoERP != 'S')
                {
                  <div class="text-center text-muted">
                    <i class="fas fa-calendar-times fa-2x mb-2"></i>
                    <p>No hay fechas especiales registradas</p>
                  </div>
                }
              </div>
            </div>
          }

          <!-- Card: Notas (EDITABLE) -->
          <div class="card card-secondary card-outline">
            <div class="card-header">
              <h3 class="card-title">
                <i class="fas fa-sticky-note"></i> Notas
              </h3>
            </div>
            <div class="card-body">
              <div class="form-group">
                <textarea class="form-control" name="Notas" rows="6"
                          placeholder="Agregue notas sobre esta cotización..."
                          maxlength="2000"
                          @(Model.EstadoActual != 'B' ? "readonly" : "")>@Model.Notas</textarea>
                <small class="text-muted">Máximo 2000 caracteres</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</section>

<!-- Modal para Editar/Agregar Detalle -->
<div class="modal fade" id="modalEditarDetalle" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title text-white" id="modalEditarDetalleTitle">
          <i class="fas fa-edit"></i> Editar Detalle
        </h5>
        <button type="button" class="close text-white" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <form id="formEditarDetalle">
          <input type="hidden" id="detalleIndex" />
          <input type="hidden" id="detalleVersionId" />
          <input type="hidden" id="modalPorcentajeImpuesto" value="0" />

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label for="modalProductoId">Producto *</label>
                @if (Model.UsarProductosErp)
                {
                  <!-- Modo ERP: Select con búsqueda de productos -->
                  <select class="form-control" id="modalProductoId" required>
                    <option value="">Seleccione un producto...</option>
                  </select>
                }
                else
                {
                  <!-- Modo Manual: Input de texto para código de producto -->
                  <input type="text" class="form-control" id="modalProductoId" 
                         placeholder="Ingrese el código del producto" 
                         maxlength="50" required>
                  <small class="text-muted">Ingrese el código del producto manualmente</small>
                }
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label for="modalDescripcionProducto">Descripción *</label>
                <input type="text" class="form-control" id="modalDescripcionProducto"
                       placeholder="Descripción del producto" required>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-3">
              <div class="form-group">
                <label for="modalCantidad">Cantidad *</label>
                <input type="number" step="0.01" min="0.01" class="form-control"
                       id="modalCantidad" required>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="modalPrecioUnitario">Precio Unitario *</label>
                <input type="number" step="0.01" min="0" class="form-control"
                       id="modalPrecioUnitario" required>
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="modalDescuento">Descuento</label>
                <input type="number" step="0.01" min="0" class="form-control"
                       id="modalDescuento" value="0">
              </div>
            </div>
            <div class="col-md-3">
              <div class="form-group">
                <label for="modalPorcentajeImpuestoDisplay">% Impuesto</label>
                @if (Model.UsarProductosErp)
                {
                  <!-- Modo ERP: Solo lectura, se llena desde el producto -->
                  <input type="text" class="form-control" id="modalPorcentajeImpuestoDisplay" readonly
                         placeholder="0%" title="Porcentaje de impuesto del producto">
                }
                else
                {
                  <!-- Modo Manual: Editable, permite modificar el porcentaje -->
                  <input type="number" step="0.01" min="0" max="100" class="form-control" 
                         id="modalPorcentajeImpuestoDisplay"
                         placeholder="0.00" title="Porcentaje de impuesto (editable)">
                  <small class="text-muted">Porcentaje aplicable (ej: 13.00)</small>
                }
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-12">
              <div class="form-group">
                <label>Total de Línea:</label>
                <div class="form-control-plaintext font-weight-bold text-success"
                     id="modalTotalLinea">
                  ¢0.00
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">
          <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="button" class="btn btn-primary" id="btnGuardarDetalle">
          <i class="fas fa-save"></i> Guardar
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Confirmación Genérico -->
<div class="modal fade" id="modalConfirmacion" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header" id="modalConfirmacionHeader">
        <h5 class="modal-title" id="modalConfirmacionTitulo">
          <i class="fas fa-question-circle"></i> Confirmar Acción
        </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body" id="modalConfirmacionMensaje">
        <!-- Mensaje dinámico -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">
          <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="button" class="btn btn-primary" id="btnConfirmarAccion">
          <i class="fas fa-check"></i> Aceptar
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Búsqueda de Interesados HubSpot -->
<div class="modal fade" id="modalBuscarInteresadoHubSpot" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title text-white">
          <i class="fas fa-search"></i> Buscar Interesado en HubSpot
        </h5>
        <button type="button" class="close text-white" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <!-- Alerta para mensajes -->
        <div id="alertBuscarInteresado" class="alert d-none" role="alert"></div>

        <!-- Filtros de búsqueda -->
        <div class="row mb-3">
          <div class="col-md-4">
            <label class="d-block mb-2">
              <strong>Tipo de Interesado:</strong>
            </label>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="tipoInteresadoHubSpot"
                     id="radioContacto" value="P" checked>
              <label class="form-check-label" for="radioContacto">
                <i class="fas fa-user"></i> Contacto
              </label>
            </div>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="tipoInteresadoHubSpot"
                     id="radioEmpresa" value="E">
              <label class="form-check-label" for="radioEmpresa">
                <i class="fas fa-building"></i> Empresa
              </label>
            </div>
          </div>
          <div class="col-md-8">
            <label for="textoBusquedaHubSpot">
              <strong>Buscar:</strong>
            </label>
            <div class="input-group">
              <input type="text" class="form-control" id="textoBusquedaHubSpot"
                     placeholder="Ingrese nombre, email o empresa...">
              <div class="input-group-append">
                <button class="btn btn-primary" type="button" id="btnBuscarHubSpotModal">
                  <i class="fas fa-search"></i> Buscar
                </button>
              </div>
            </div>
            <small class="text-muted">Mínimo 3 caracteres para buscar</small>
          </div>
        </div>

        <!-- Spinner de carga -->
        <div id="spinnerBusquedaHubSpot" class="text-center py-5 d-none">
          <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Buscando...</span>
          </div>
          <p class="mt-2 text-muted">Buscando en HubSpot...</p>
        </div>

        <!-- Tabla de resultados -->
        <div id="resultadosBusquedaHubSpot" class="d-none">
          <hr>
          <h6 class="mb-3">
            <i class="fas fa-list"></i> Resultados de Búsqueda
            <span class="badge badge-info ml-2" id="contadorResultados">0</span>
          </h6>
          <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
            <table class="table table-sm table-hover" id="tablaResultadosHubSpot">
              <thead class="thead-light">
                <tr>
                  <th>Nombre</th>
                  <th>Email</th>
                  <th>Empresa</th>
                  <th class="text-center" style="width: 100px;">Acción</th>
                </tr>
              </thead>
              <tbody>
                <!-- Resultados dinámicos -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Mensaje cuando no hay resultados -->
        <div id="sinResultadosHubSpot" class="text-center py-4 d-none">
          <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
          <p class="text-muted">No se encontraron resultados</p>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">
          <i class="fas fa-times"></i> Cerrar
        </button>
      </div>
    </div>
  </div>
</div>

@section Styles {
  <link rel="stylesheet" href="~/css/cotizaciones/detalle.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/cotizaciones/editor.css" asp-append-version="true">
  <!-- Select2 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

@section Scripts {
  <!-- Configuración específica del servidor para esta vista -->
  <script>
    // Extender FormatConfig con datos específicos del servidor
    if (window.FormatConfig) {
        window.FormatConfig.moneda = '@Model.Moneda';
        window.FormatConfig.simboloMoneda = '@FormatHelper.GetCurrencySymbol(Model.Moneda)';
        window.FormatConfig.estado = '@Model.EstadoActual';
        window.FormatConfig.tipoCambio = @(Model.TipoCambio?.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) ?? "null");
        window.FormatConfig.esNuevaCotizacion = @Model.EsNuevaCotizacion.ToString().ToLower();
    } else {
        // Fallback si FormatConfig no está disponible
        window.FormatConfig = {
            moneda: '@Model.Moneda',
            simboloMoneda: '@FormatHelper.GetCurrencySymbol(Model.Moneda)',
            estado: '@Model.EstadoActual',
            tipoCambio: @(Model.TipoCambio?.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) ?? "null"),
            esNuevaCotizacion: @Model.EsNuevaCotizacion.ToString().ToLower()
        };
    }
    
    // Configuración de impuestos desde parámetros del sistema
    window.ConfigImpuestos = {
        usarImpuestosErp: '@Model.UsarImpuestosErp',
        tasaImpuesto: @Model.TasaImpuesto.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
    };

    // Configuración de productos ERP
    window.ConfigProductos = {
        usarProductosErp: @Model.UsarProductosErp.ToString().ToLower()
    };

    // Agregar monedas disponibles desde el servidor
    window.MonedasDisponibles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MonedasDisponibles ?? FormatHelper.GetMonedasDisponiblesParaJson()));

    console.log('=== CONFIGURACIÓN DESDE SERVIDOR ===');
    console.log('Moneda:', '@Model.Moneda');
    console.log('Estado:', '@Model.EstadoActual');
    console.log('Estado Texto:', '@Model.EstadoActualTexto');
    console.log('Estado es editable?:', '@Model.EstadoActual' === 'B');
    console.log('Es nueva cotización?:', @Model.EsNuevaCotizacion.ToString().ToLower());
    console.log('Monedas disponibles tipo:', typeof window.MonedasDisponibles);
    console.log('Monedas disponibles:', window.MonedasDisponibles);
    console.log('Puede cambiar moneda?:', @Model.PuedeCambiarMoneda.ToString().ToLower());
    console.log('FormatConfig después:', window.FormatConfig);
    console.log('ConfigImpuestos:', window.ConfigImpuestos);
    console.log('ConfigProductos:', window.ConfigProductos);
    console.log('====================================');
  </script>
  <!-- Select2 JS -->
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="~/js/cotizaciones/editor.js" asp-append-version="true"></script>
}