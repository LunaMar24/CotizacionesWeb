@model CotizacionesWeb.UI.Models.CotizacionEditarViewModel
@{
    ViewData["Title"] = $"Editar Cotización {Model.CotizacionId}";
}

<!-- Header Principal -->
<div class="content-header-custom">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="header-title">
                <i class="fas fa-edit"></i> 
                Editar Cotización @Model.CotizacionId
                <span class="badge badge-secondary-custom ml-2">@Model.EstadoActualTexto</span>
            </h1>
            <p class="header-subtitle">
                Modifica la información de la cotización, sus líneas de productos y configuraciones.
                <br><small class="text-muted"><i class="fas fa-info-circle"></i> Solo las cotizaciones en estado <strong>Borrador</strong> pueden ser editadas.</small>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Volver al Listado
            </a>
            @if (Model.EstadoActual == 'B')
            {
                <button type="button" class="btn btn-success" id="btnGuardar">
                    <i class="fas fa-save"></i> Guardar Cambios
                </button>
            }
            else
            {
                <button type="button" class="btn btn-secondary" disabled title="Solo se puede guardar en estado Borrador">
                    <i class="fas fa-lock"></i> No Editable
                </button>
            }
        </div>
    </div>
</div>

<section class="content">
<div class="container-fluid">

    <!-- Alerta para cotizaciones no editables -->
    @if (Model.EstadoActual != 'B')
    {
        <div class="alert alert-warning mb-4">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Atención:</strong> Esta cotización está en estado <strong>@Model.EstadoActualTexto</strong> y no puede ser editada. 
            Solo las cotizaciones en estado <strong>Borrador</strong> permiten edición.
        </div>
    }

    <form id="formEditarCotizacion">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CotizacionId" value="@Model.CotizacionId" />
        <input type="hidden" name="VersionId" value="@Model.VersionId" />
        
        <div class="row">
            <!-- Columna Principal -->
            <div class="col-lg-8">
                <!-- Card: Información General (Solo Lectura) -->
                <div class="card card-primary card-outline mb-4">
                    <div class="card-header" data-card-widget="collapse" style="cursor: pointer;">
                        <h3 class="card-title">
                            <i class="fas fa-info-circle"></i> Información General
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-item">
                                    <div class="d-flex">
                                        <strong class="info-label">ID Cotización:</strong>
                                        <span class="text-primary font-weight-bold">@Model.CotizacionId</span>
                                    </div>
                                </div>
                                <div class="info-item">
                                    <div class="d-flex">
                                        <strong class="info-label">Estado Actual:</strong>
                                        <span>
                                            @switch (Model.EstadoActual)
                                            {
                                                case 'B':
                                                    <span class="badge badge-secondary-custom">@Model.EstadoActualTexto</span>
                                                    break;
                                                case 'P':
                                                    <span class="badge badge-warning-custom">@Model.EstadoActualTexto</span>
                                                    break;
                                                case 'A':
                                                    <span class="badge badge-success-custom">@Model.EstadoActualTexto</span>
                                                    break;
                                                case 'E':
                                                    <span class="badge badge-info-custom">@Model.EstadoActualTexto</span>
                                                    break;
                                                case 'T':
                                                    <span class="badge badge-primary-custom">@Model.EstadoActualTexto</span>
                                                    break;
                                                case 'R':
                                                    <span class="badge badge-danger-custom">@Model.EstadoActualTexto</span>
                                                    break;
                                                case 'X':
                                                    <span class="badge badge-dark-custom">@Model.EstadoActualTexto</span>
                                                    break;
                                                default:
                                                    <span class="badge badge-light">@Model.EstadoActualTexto</span>
                                                    break;
                                            }
                                        </span>
                                    </div>
                                </div>
                                <div class="info-item">
                                    <div class="d-flex">
                                        <strong class="info-label">Versión:</strong>
                                        <span>
                                            <span class="badge badge-version">@FormatHelper.FormatVersion(Model.NumeroVersion)</span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-item">
                                    <div class="d-flex">
                                        <strong class="info-label">Fecha Creación:</strong>
                                        <span>@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>
                                <div class="info-item">
                                    <div class="d-flex">
                                        <strong class="info-label">Fecha Versión:</strong>
                                        <span>@Model.FechaVersion.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>
                                @if (Model.FechaUltimaActualizacion.HasValue)
                                {
                                    <div class="info-item">
                                        <div class="d-flex">
                                            <strong class="info-label">Última Actualización:</strong>
                                            <span>@Model.FechaUltimaActualizacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card: Información del Interesado (EDITABLE) -->
                <div class="card card-info card-outline mb-4">
                    <div class="card-header" data-card-widget="collapse" style="cursor: pointer;">
                        <h3 class="card-title">
                            <i class="fas fa-user-edit"></i> Información del Interesado
                        </h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label for="selectInteresado" class="form-label">
                                    <i class="fas fa-search"></i> Buscar Interesado
                                </label>
                                <select class="form-control select2" id="selectInteresado" name="InteresadoId" 
                                        @(Model.EstadoActual != 'B' ? "disabled" : "")>
                                    <option value="">Seleccione un interesado...</option>
                                    @* Los datos se cargarán dinámicamente desde JavaScript *@
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="NombreInteresado">Nombre del Interesado</label>
                                    <input type="text" class="form-control" id="NombreInteresado" name="NombreInteresado" 
                                           value="@Model.NombreInteresado" placeholder="Nombre completo"
                                           @(Model.EstadoActual != 'B' ? "readonly" : "")>
                                </div>
                                <div class="form-group">
                                    <label for="EmailInteresado">Email</label>
                                    <input type="email" class="form-control" id="EmailInteresado" name="EmailInteresado" 
                                           value="@Model.EmailInteresado" placeholder="email@ejemplo.com"
                                           @(Model.EstadoActual != 'B' ? "readonly" : "")>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="EmpresaInteresado">Empresa</label>
                                    <input type="text" class="form-control" id="EmpresaInteresado" name="EmpresaInteresado" 
                                           value="@Model.EmpresaInteresado" placeholder="Nombre de la empresa"
                                           @(Model.EstadoActual != 'B' ? "readonly" : "")>
                                </div>
                                <div class="form-group">
                                    <label for="TipoInteresado">Tipo de Interesado</label>
                                    <select class="form-control" id="TipoInteresado" name="TipoInteresado"
                                            @(Model.EstadoActual != 'B' ? "disabled" : "")>
                                        <option value="P" selected="@(Model.TipoInteresado == 'P')">Persona</option>
                                        <option value="E" selected="@(Model.TipoInteresado == 'E')">Empresa</option>
                                        <option value="O" selected="@(Model.TipoInteresado == 'O')">Otro</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card: Líneas de Detalle (EDITABLE) -->
                <div class="card card-success card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-list-ul"></i> Líneas de Detalle
                        </h3>
                        <div class="card-tools">
                            @if (Model.EstadoActual == 'B')
                            {
                                <button type="button" class="btn btn-success btn-sm" id="btnAgregarLinea">
                                    <i class="fas fa-plus"></i> Agregar Línea
                                </button>
                            }
                            <span class="badge badge-success ml-2" id="contadorLineas">@Model.Detalles.Count item(s)</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                            <table class="table table-sm table-striped mb-0" id="tablaDetalles">
                                <thead class="thead-light sticky-top">
                                    <tr>
                                        <th style="background-color: #f8f9fa; width: 120px;">Producto</th>
                                        <th style="background-color: #f8f9fa;">Descripción</th>
                                        <th class="text-right" style="background-color: #f8f9fa; width: 100px;">Cantidad</th>
                                        <th class="text-right" style="background-color: #f8f9fa; width: 120px;">Precio Unit.</th>
                                        <th class="text-right" style="background-color: #f8f9fa; width: 120px;">Descuento</th>
                                        <th class="text-right" style="background-color: #f8f9fa; width: 120px;">Total</th>
                                        <th class="text-center" style="background-color: #f8f9fa; width: 80px;">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Detalles.Count; i++)
                                    {
                                        <tr data-detalle-id="@Model.Detalles[i].DetalleVersionId" data-index="@i">
                                            <td>
                                                <strong class="text-primary">@Model.Detalles[i].ProductoId</strong>
                                                <input type="hidden" name="Detalles[@i].DetalleVersionId" value="@Model.Detalles[i].DetalleVersionId" />
                                                <input type="hidden" name="Detalles[@i].ProductoId" value="@Model.Detalles[i].ProductoId" />
                                            </td>
                                            <td>
                                                <span class="producto-nombre">@Model.Detalles[i].ProductoNombre</span>
                                                <input type="hidden" name="Detalles[@i].ProductoNombre" value="@Model.Detalles[i].ProductoNombre" />
                                            </td>
                                            <td class="text-right">
                                                <span class="cantidad-display">@FormatHelper.FormatNumber(Model.Detalles[i].Cantidad, 2)</span>
                                                <input type="hidden" name="Detalles[@i].Cantidad" value="@Model.Detalles[i].Cantidad" />
                                            </td>
                                            <td class="text-right">
                                                <span class="precio-display">@FormatHelper.FormatCurrency(Model.Detalles[i].PrecioUnitario, Model.Moneda)</span>
                                                <input type="hidden" name="Detalles[@i].PrecioUnitario" value="@Model.Detalles[i].PrecioUnitario" />
                                            </td>
                                            <td class="text-right">
                                                @if (Model.Detalles[i].Descuento > 0)
                                                {
                                                    <span class="text-danger descuento-display">-@FormatHelper.FormatCurrency(Model.Detalles[i].Descuento, Model.Moneda)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted descuento-display">-</span>
                                                }
                                                <input type="hidden" name="Detalles[@i].Descuento" value="@Model.Detalles[i].Descuento" />
                                            </td>
                                            <td class="text-right">
                                                <strong class="total-linea-display">@FormatHelper.FormatCurrency(Model.Detalles[i].TotalLinea, Model.Moneda)</strong>
                                                <input type="hidden" name="Detalles[@i].TotalLinea" value="@Model.Detalles[i].TotalLinea" />
                                            </td>
                                            <td class="text-center">
                                                @if (Model.EstadoActual == 'B')
                                                {
                                                    <button type="button" class="btn btn-warning btn-xs btn-editar-detalle" 
                                                            data-index="@i" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-danger btn-xs ml-1 btn-eliminar-detalle" 
                                                            data-index="@i" title="Eliminar">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        <i class="fas fa-lock"></i>
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar Derecha -->
            <div class="col-lg-4">
                <!-- Card: Resumen Financiero -->
                <div class="card card-warning card-outline mb-4">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-calculator"></i> Resumen Financiero
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="financial-summary">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal:</span>
                                <strong id="displaySubTotal">@FormatHelper.FormatCurrency(Model.SubTotal, Model.Moneda)</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Descuento:</span>
                                <strong class="text-danger" id="displayDescuento">@FormatHelper.FormatCurrency(Model.Descuento, Model.Moneda)</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal Descontado:</span>
                                <strong class="text-primary" id="displaySubtotalDescontado">@FormatHelper.FormatCurrency(Model.SubTotal - Model.Descuento, Model.Moneda)</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Impuesto (13%):</span>
                                <strong class="text-info" id="displayImpuesto">@FormatHelper.FormatCurrency(Model.Impuesto, Model.Moneda)</strong>
                            </div>
                            <hr class="my-3">
                            <div class="d-flex justify-content-between mb-3">
                                <span class="h5">Total:</span>
                                <strong class="h5 text-success" id="displayTotal">@FormatHelper.FormatCurrency(Model.Total, Model.Moneda)</strong>
                            </div>
                            <div class="text-center text-muted">
                                <small>
                                    <strong>Moneda:</strong> @Model.Moneda
                                    @if (Model.TipoCambio.HasValue && Model.TipoCambio > 0)
                                    {
                                        <br><strong>Tipo de Cambio:</strong> @Model.TipoCambio.Value.ToString("N4")
                                    }
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card: Fechas Importantes (Solo Lectura) -->
                <div class="card card-info card-outline mb-4">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-calendar-alt"></i> Fechas Importantes
                        </h3>
                    </div>
                    <div class="card-body">
                        @if (Model.FechaEnvio.HasValue)
                        {
                            <div class="info-item">
                                <div class="d-flex">
                                    <strong class="info-label">Fecha Envío:</strong>
                                    <span>@Model.FechaEnvio.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                        }
                        @if (Model.FechaAceptacion.HasValue)
                        {
                            <div class="info-item">
                                <div class="d-flex">
                                    <strong class="info-label">Fecha Aceptación:</strong>
                                    <span class="text-success">@Model.FechaAceptacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                        }
                        @if (Model.FechaRechazo.HasValue)
                        {
                            <div class="info-item">
                                <div class="d-flex">
                                    <strong class="info-label">Fecha Rechazo:</strong>
                                    <span class="text-danger">@Model.FechaRechazo.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                        }
                        @if (Model.EnviadoERP == 'S' && Model.FechaEnvioERP.HasValue)
                        {
                            <div class="info-item">
                                <div class="d-flex">
                                    <strong class="info-label">Enviado al ERP:</strong>
                                    <span class="text-primary">@Model.FechaEnvioERP.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                        }
                        @if (!Model.FechaEnvio.HasValue && !Model.FechaAceptacion.HasValue && !Model.FechaRechazo.HasValue && Model.EnviadoERP != 'S')
                        {
                            <div class="text-center text-muted">
                                <i class="fas fa-calendar-times fa-2x mb-2"></i>
                                <p>No hay fechas especiales registradas</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Card: Notas (EDITABLE) -->
                <div class="card card-secondary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-sticky-note"></i> Notas
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <textarea class="form-control" name="Notas" rows="6" 
                                      placeholder="Agregue notas sobre esta cotización..." 
                                      maxlength="2000"
                                      @(Model.EstadoActual != 'B' ? "readonly" : "")>@Model.Notas</textarea>
                            <small class="text-muted">Máximo 2000 caracteres</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
</section>

<!-- Modal para Editar/Agregar Detalle -->
<div class="modal fade" id="modalEditarDetalle" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white" id="modalEditarDetalleTitle">
                    <i class="fas fa-edit"></i> Editar Detalle
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="formEditarDetalle">
                    <input type="hidden" id="detalleIndex" />
                    <input type="hidden" id="detalleVersionId" />
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="modalProductoId">Producto *</label>
                                <select class="form-control" id="modalProductoId" required>
                                    <option value="">Seleccione un producto...</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="modalProductoNombre">Descripción *</label>
                                <input type="text" class="form-control" id="modalProductoNombre" 
                                       placeholder="Descripción del producto" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="modalCantidad">Cantidad *</label>
                                <input type="number" step="0.01" min="0.01" class="form-control" 
                                       id="modalCantidad" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="modalPrecioUnitario">Precio Unitario *</label>
                                <input type="number" step="0.01" min="0" class="form-control" 
                                       id="modalPrecioUnitario" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="modalDescuento">Descuento</label>
                                <input type="number" step="0.01" min="0" class="form-control" 
                                       id="modalDescuento" value="0">
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label>Total de Línea:</label>
                                <div class="form-control-plaintext font-weight-bold text-success" 
                                     id="modalTotalLinea">?0.00</div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btnGuardarDetalle">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/cotizaciones/detalle.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/cotizaciones/editar.css" asp-append-version="true">
}

@section Scripts {
    <!-- Exponer configuración del FormatHelper a JavaScript -->
    <script>
        window.FormatConfig = {
            moneda: '@Model.Moneda',
            simboloMoneda: '@FormatHelper.GetCurrencySymbol(Model.Moneda)',
            estado: '@Model.EstadoActual'
        };
    </script>
    <script src="~/js/cotizaciones/editar.js" asp-append-version="true"></script>
}