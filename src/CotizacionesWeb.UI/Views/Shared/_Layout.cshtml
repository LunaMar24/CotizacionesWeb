@using CotizacionesWeb.UI.Services
@inject IPermisoChecker PermisoChecker

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <title>@ViewData["Title"] - CotizacionesWeb</title>

  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- AdminLTE Theme style -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
  <!-- Custom Color Variables -->
  <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true">
  <!-- Custom Modals -->
  <link rel="stylesheet" href="~/css/modals.css" asp-append-version="true">
  <!-- Custom Components -->
  <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
  <!-- Custom Site CSS -->
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-footer-fixed">
  <!-- Site wrapper -->
  <div class="wrapper">
    <!-- Navbar -->
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
      <!-- Left navbar links -->
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
      </ul>

      <!-- Right navbar links -->
      <ul class="navbar-nav ml-auto">
        @if (User.Identity?.IsAuthenticated == true)
        {
          <li class="nav-item dropdown">
            <a class="nav-link" data-toggle="dropdown" href="#" role="button">
              <i class="far fa-user"></i>
              <span class="ml-1">@User.Identity.Name</span>
            </a>
            <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
              <span class="dropdown-item dropdown-header">Información del Usuario</span>
              <div class="dropdown-divider"></div>
              <a href="#" class="dropdown-item">
                <i class="fas fa-user mr-2"></i> @User.Identity.Name
              </a>
              <a href="#" class="dropdown-item">
                <i class="fas fa-envelope mr-2"></i> @User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value
              </a>
              @if (User.IsInRole("Admin") || User.IsInRole("Administrador"))
              {
                <a href="#" class="dropdown-item">
                  <i class="fas fa-shield-alt mr-2"></i> Administrador
                </a>
              }
              <div class="dropdown-divider"></div>
              <form asp-controller="Account" asp-action="Logout" method="post" class="dropdown-item" style="padding: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link dropdown-item text-left" style="width: 100%; text-decoration: none;">
                  <i class="fas fa-sign-out-alt mr-2"></i> Cerrar Sesión
                </button>
              </form>
            </div>
          </li>
        }
      </ul>
    </nav>
    <!-- /.navbar -->
    <!-- Main Sidebar Container -->
    <aside class="main-sidebar sidebar-dark-primary elevation-4">
      <!-- Brand Logo -->
      <a asp-controller="Home" asp-action="Index" class="brand-link" style="text-align: center; display: block; padding: 1rem 1.5rem;">
        <img src="~/img/aplix-logo.png" alt="APLIX Logo" class="brand-image" style="opacity: .9; width: 100px; height: 100px; object-fit: contain; margin: 0 auto; display: block;">
        <span class="brand-text font-weight-light d-block" style="margin-top: 12px; font-size: 1.1rem;">CotizacionesWeb</span>
      </a>

      <!-- Sidebar -->
      <div class="sidebar">
        <!-- Sidebar Menu -->
        <nav class="mt-2">
          @{
            var isAuthenticated = User.Identity?.IsAuthenticated == true;
            var tieneUsuariosView = isAuthenticated && await PermisoChecker.TienePermisoAsync("USR_VIEW");
            var tieneRolesView = isAuthenticated && await PermisoChecker.TienePermisoAsync("ROL_VIEW");
            var esAdmin = User.IsInRole("Admin") || User.IsInRole("Administrador");
            var tieneAdminMenu = tieneUsuariosView || tieneRolesView || esAdmin;

            var tieneCotView = isAuthenticated && await PermisoChecker.TienePermisoAsync("COT_VIEW");
            var tieneCotCreate = isAuthenticated && await PermisoChecker.TienePermisoAsync("COT_CREATE");
            var tieneCotizacionesMenu = tieneCotView || tieneCotCreate;

            var tieneConfigParams = isAuthenticated && await PermisoChecker.TienePermisoAsync("CFG_PARAMS_VIEW");
            var tieneConfigMenu = tieneConfigParams || esAdmin;
          }

          <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
            @if (isAuthenticated)
            {
              <li class="nav-item">
                <a asp-controller="Home" asp-action="Index" class="nav-link">
                  <i class="nav-icon fas fa-home"></i>
                  <p>Inicio</p>
                </a>
              </li>

              @if (tieneAdminMenu)
              {
                <li class="nav-item">
                  <a href="#" class="nav-link">
                    <i class="nav-icon fas fa-users-cog"></i>
                    <p>
                      Administración
                      <i class="right fas fa-angle-left"></i>
                    </p>
                  </a>
                  <ul class="nav nav-treeview">
                    @if (tieneUsuariosView || esAdmin)
                    {
                      <li class="nav-item">
                        <a asp-controller="Usuarios" asp-action="Index" class="nav-link">
                          <i class="far fa-circle nav-icon"></i>
                          <p>Usuarios</p>
                        </a>
                      </li>
                    }
                    @if (tieneRolesView || esAdmin)
                    {
                      <li class="nav-item">
                        <a asp-controller="Roles" asp-action="Index" class="nav-link">
                          <i class="far fa-circle nav-icon"></i>
                          <p>Roles</p>
                        </a>
                      </li>
                    }
                  </ul>
                </li>
              }

              @if (tieneCotizacionesMenu)
              {
                <li class="nav-item">
                  <a href="#" class="nav-link">
                    <i class="nav-icon fas fa-file-invoice"></i>
                    <p>
                      Cotizaciones
                      <i class="right fas fa-angle-left"></i>
                    </p>
                  </a>
                  <ul class="nav nav-treeview">
                    @if (tieneCotView)
                    {
                      <li class="nav-item">
                        <a asp-controller="Cotizaciones" asp-action="Index" class="nav-link">
                          <i class="far fa-circle nav-icon"></i>
                          <p>Gestión Cotizaciones</p>
                        </a>
                      </li>
                    }
                    @if (tieneCotCreate)
                    {
                      <li class="nav-item">
                        <a href="#" class="nav-link">
                          <i class="far fa-circle nav-icon"></i>
                          <p>Nueva Cotización</p>
                        </a>
                      </li>
                    }
                  </ul>
                </li>
              }

              @if (tieneConfigMenu)
              {
                <li class="nav-item">
                  <a href="#" class="nav-link">
                    <i class="nav-icon fas fa-cogs"></i>
                    <p>
                      Configuración
                      <i class="right fas fa-angle-left"></i>
                    </p>
                  </a>
                  <ul class="nav nav-treeview">
                    @if (tieneConfigParams || esAdmin)
                    {
                      <li class="nav-item">
                        <a asp-controller="Configuracion" asp-action="Parametros" class="nav-link">
                          <i class="far fa-circle nav-icon"></i>
                          <p>Parámetros del Sistema</p>
                        </a>
                      </li>
                    }
                  </ul>
                </li>
              }
            }
          </ul>
        </nav>
        <!-- /.sidebar-menu -->
      </div>
      <!-- /.sidebar -->
    </aside>

    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
      <!-- Main content -->
      <section class="content">
        <div class="container-fluid">
          @RenderBody()
        </div>
      </section>
      <!-- /.content -->
    </div>
    <!-- /.content-wrapper -->

    <footer class="main-footer">
      <div class="float-right d-none d-sm-block">
        <b>Versión</b> 1.0.0
      </div>
      <strong>&copy; 2026 CotizacionesWeb.</strong> Todos los derechos reservados.
    </footer>

    <!-- Control Sidebar -->
    <aside class="control-sidebar control-sidebar-dark">
      <!-- Control sidebar content goes here -->
    </aside>
    <!-- /.control-sidebar -->
  </div>
  <!-- ./wrapper -->
  <!-- jQuery -->
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <!-- Bootstrap 4 -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
  <!-- AdminLTE App -->
  <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
  <!-- Format Config (ANTES de otros scripts) -->
  <script src="~/js/shared/format-config.js" asp-append-version="true"></script>
  <!-- Custom Modals JS -->
  <script src="~/js/modals.js" asp-append-version="true"></script>
  <!-- Custom Site JS -->
  <script src="~/js/site.js" asp-append-version="true"></script>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

